/// Generated by tools/make_houdini_ds.py; edit that, not this file.
/// hdPbrt light properties ("pbrt:*" attributes on UsdLux light prims).
#include "$HFS/houdini/soho/parameters/CommonMacros.ds"
{
    name    "pbrt"
    label   "pbrt"
    parmtag { spare_opfilter "!!SHOP/PROPERTIES!!" }
    parmtag { spare_classtags "render" }

    parm {
        name    "xn__pbrtspectrum_control_l8a"
        label   "Spectrum"
        type    string
        default { "none" }
        menujoin {
            [ "import loputils" ]
            [ "return loputils.createEditPropertiesControlMenu(kwargs, 'string')" ]
            language python
        }
        parmtag { "sidefx::look" "icon" }
    }
    parm {
        name    "xn__pbrtspectrum_kva"
        label   "Spectrum"
        type    string
        size    1
        default { "rgb" }
        menu {
            "rgb" "rgb"
            "band" "band"
            "blackbody" "blackbody"
        }
        help    "rgb: the light's color (UsdLux). band: a Gaussian at Wavelength with FWHM Bandwidth (nm, 360-1100), carrying the radiant power of a white light of the same intensity, so it can be invisible infrared. blackbody: a spectral black body at the color temperature (infrared included), as bright as a white light. The spectral modes ignore color; textured lights stay RGB."
        parmtag { "spare_category" "Spectrum" }
        parmtag { "uiscope" "viewport" }
        parmtag { "usdvaluetype" "token" }
        disablewhen "{ xn__pbrtspectrum_control_l8a == block } { xn__pbrtspectrum_control_l8a == none }"
    }

    parm {
        name    "xn__pbrtwavelength_control_ucb"
        label   "Wavelength (nm)"
        type    string
        default { "none" }
        menujoin {
            [ "import loputils" ]
            [ "return loputils.createEditPropertiesControlMenu(kwargs, 'float')" ]
            language python
        }
        parmtag { "sidefx::look" "icon" }
    }
    parm {
        name    "xn__pbrtwavelength_tya"
        label   "Wavelength (nm)"
        type    float
        size    1
        default { 850.0 }
        range   { 360 1100 }
        help    "Peak wavelength of a band light."
        parmtag { "spare_category" "Spectrum" }
        parmtag { "uiscope" "viewport" }
        parmtag { "usdvaluetype" "float" }
        disablewhen "{ xn__pbrtwavelength_control_ucb == block } { xn__pbrtwavelength_control_ucb == none }"
        hidewhen "{ xn__pbrtspectrum_kva != "band" }"
    }

    parm {
        name    "xn__pbrtbandwidth_control_79a"
        label   "Bandwidth (nm)"
        type    string
        default { "none" }
        menujoin {
            [ "import loputils" ]
            [ "return loputils.createEditPropertiesControlMenu(kwargs, 'float')" ]
            language python
        }
        parmtag { "sidefx::look" "icon" }
    }
    parm {
        name    "xn__pbrtbandwidth_6wa"
        label   "Bandwidth (nm)"
        type    float
        size    1
        default { 40.0 }
        range   { 1 400 }
        help    "Full width at half maximum of a band light."
        parmtag { "spare_category" "Spectrum" }
        parmtag { "uiscope" "viewport" }
        parmtag { "usdvaluetype" "float" }
        disablewhen "{ xn__pbrtbandwidth_control_79a == block } { xn__pbrtbandwidth_control_79a == none }"
        hidewhen "{ xn__pbrtspectrum_kva != "band" }"
    }

}
