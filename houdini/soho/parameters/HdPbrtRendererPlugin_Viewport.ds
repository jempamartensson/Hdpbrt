/// Generated by tools/make_houdini_ds.py; edit that, not this file.
/// hdPbrt renderer settings in the viewport display options (SetRenderSetting).
#include "$HFS/houdini/soho/parameters/CommonMacros.ds"
{
    name    "pbrt"
    label   "pbrt"
    parmtag { spare_opfilter "!!SHOP/PROPERTIES!!" }
    parmtag { spare_classtags "render" }

    parm {
        name    "xn__pbrtpixelSamples_21a"
        label   "Pixel Samples"
        type    integer
        size    1
        default { 256 }
        range   { 1 4096 }
        help    "Samples per pixel; the render stops there (the viewport refines progressively)."
        parmtag { "spare_category" "Sampling" }
        parmtag { "uiscope" "viewport" }
        parmtag { "usdvaluetype" "int" }
    }

    parm {
        name    "xn__pbrtsampler_xta"
        label   "Sampler"
        type    string
        size    1
        default { "zsobol" }
        menu {
            "zsobol" "zsobol"
            "sobol" "sobol"
            "paddedsobol" "paddedsobol"
            "halton" "halton"
            "pmj02bn" "pmj02bn"
            "stratified" "stratified"
            "independent" "independent"
        }
        help    "pbrt's sampler."
        parmtag { "spare_category" "Sampling" }
        parmtag { "uiscope" "viewport" }
        parmtag { "usdvaluetype" "token" }
    }

    parm {
        name    "xn__pbrtmaxDepth_kva"
        label   "Max Depth"
        type    integer
        size    1
        default { 5 }
        range   { 1 64 }
        help    "Maximum path length (1 = direct lighting only)."
        parmtag { "spare_category" "Integrator" }
        parmtag { "uiscope" "viewport" }
        parmtag { "usdvaluetype" "int" }
    }

    parm {
        name    "xn__pbrtintegrator_tya"
        label   "Integrator"
        type    string
        size    1
        default { "volpath" }
        menu {
            "volpath" "volpath"
            "path" "path"
            "bdpt" "bdpt"
            "mlt" "mlt"
            "sppm" "sppm"
            "simplepath" "simplepath"
            "simplevolpath" "simplevolpath"
            "lightpath" "lightpath"
            "ambientocclusion" "ambientocclusion"
            "randomwalk" "randomwalk"
        }
        help    "pbrt's integrator. volpath handles media, light linking and all hdPbrt features."
        parmtag { "spare_category" "Integrator" }
        parmtag { "uiscope" "viewport" }
        parmtag { "usdvaluetype" "token" }
    }

    parm {
        name    "xn__pbrtregularize_tya"
        label   "Regularize BSDFs"
        type    toggle
        size    1
        default { 0 }
        help    "Roughen near-specular BSDFs after the first diffuse bounce (fewer caustic fireflies, biased)."
        parmtag { "spare_category" "Integrator" }
        parmtag { "uiscope" "viewport" }
        parmtag { "usdvaluetype" "bool" }
    }

    parm {
        name    "xn__pbrtdepthOfField_21a"
        label   "Depth of Field"
        type    toggle
        size    1
        default { 1 }
        help    "Thin-lens depth of field from the camera's fStop and focusDistance."
        parmtag { "spare_category" "Camera" }
        parmtag { "uiscope" "viewport" }
        parmtag { "usdvaluetype" "bool" }
    }

    parm {
        name    "xn__pbrtmotionBlur_tya"
        label   "Motion Blur"
        type    toggle
        size    1
        default { 1 }
        help    "Transform and deformation blur over the camera's shutter."
        parmtag { "spare_category" "Motion Blur" }
        parmtag { "uiscope" "viewport" }
        parmtag { "usdvaluetype" "bool" }
    }

    parm {
        name    "xn__pbrtxformSamples_21a"
        label   "Transform Motion Samples"
        type    integer
        size    1
        default { 2 }
        range   { 2 16 }
        help    "Transform keys over the shutter (more than 2 follow curved motion)."
        parmtag { "spare_category" "Motion Blur" }
        parmtag { "uiscope" "viewport" }
        parmtag { "usdvaluetype" "int" }
    }

    parm {
        name    "xn__pbrtgeoSamples_tya"
        label   "Deformation Motion Samples"
        type    integer
        size    1
        default { 2 }
        range   { 2 16 }
        help    "Point-position keys over the shutter for deforming meshes."
        parmtag { "spare_category" "Motion Blur" }
        parmtag { "uiscope" "viewport" }
        parmtag { "usdvaluetype" "int" }
    }

    parm {
        name    "xn__pbrtsubdivLevel_g0a"
        label   "Subdivision Level"
        type    integer
        size    1
        default { 2 }
        range   { 0 6 }
        help    "Refinement level for catmullClark/loop meshes (0 = the cage)."
        parmtag { "spare_category" "Geometry" }
        parmtag { "uiscope" "viewport" }
        parmtag { "usdvaluetype" "int" }
    }

    parm {
        name    "xn__pbrtvolumeDensity_p3a"
        label   "Volume Density Scale"
        type    float
        size    1
        default { 1.0 }
        range   { 0 10 }
        help    "Density scale for volumes without a pyro shader."
        parmtag { "spare_category" "Volumes" }
        parmtag { "uiscope" "viewport" }
        parmtag { "usdvaluetype" "float" }
    }

    parm {
        name    "xn__pbrtvolumeAlbedo_21a"
        label   "Volume Albedo"
        type    float
        size    1
        default { 0.9 }
        range   { 0 1 }
        help    "Single-scattering albedo for volumes without a pyro shader."
        parmtag { "spare_category" "Volumes" }
        parmtag { "uiscope" "viewport" }
        parmtag { "usdvaluetype" "float" }
    }

    parm {
        name    "xn__pbrtvolumeTemperatureScale_djb"
        label   "Volume Temperature Scale"
        type    float
        size    1
        default { 0.0 }
        range   { 0 5000 }
        help    "Kelvin per unit of a temperature field (0 = no emission) for volumes without a pyro shader."
        parmtag { "spare_category" "Volumes" }
        parmtag { "uiscope" "viewport" }
        parmtag { "usdvaluetype" "float" }
    }

    parm {
        name    "xn__pbrtmaterialPreview_y6a"
        label   "Material Preview"
        type    toggle
        size    1
        default { 0 }
        help    "Render materials' UsdPreviewSurface (e.g. the preview a Karma Material Builder writes) instead of their MaterialX / Karma graph, to compare."
        parmtag { "spare_category" "Materials" }
        parmtag { "uiscope" "viewport" }
        parmtag { "usdvaluetype" "bool" }
    }

    parm {
        name    "xn__pbrtthreads_xta"
        label   "Threads"
        type    integer
        size    1
        default { 0 }
        range   { 0 256 }
        help    "Render threads (0 = all but two cores)."
        parmtag { "spare_category" "System" }
        parmtag { "uiscope" "viewport" }
        parmtag { "usdvaluetype" "int" }
    }

    parm {
        name    "xn__pbrtexportPath_tya"
        label   "Export .pbrt Scene To"
        type    file
        size    1
        default { "" }
        help    "Also write the pbrt scene (with its PLY meshes) here."
        parmtag { "spare_category" "System" }
        parmtag { "uiscope" "viewport" }
        parmtag { "usdvaluetype" "string" }
    }

}
