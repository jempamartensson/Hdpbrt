+// hdPbrt: procedural displacement graphs. hdPbrt compiles a MaterialX node
+// graph (the displacement terminal's upstream nodes, nodegraph-implemented
+// nodes expanded) into a small register program; plymesh evaluates it per
+// vertex during displacement ("string hdpbrtgraph", see shapes.cpp).
+//
+// Program: instructions separated by ';', each "<op> <dst> <operands...>".
+// Registers hold 4 floats; float values are broadcast to all four lanes, so
+// componentwise ops also serve MaterialX's "FA" (vector by float) variants.
+// "c <dst> x y z w" sets a constant register, "out <reg>" names the result.
+// Noise follows MaterialX's reference library (OSL's noise; Karma's VEX
+// mx_perlin / mx_cellnoise / mx_worley), vector2/vector4 noise variants as
+// Karma's mxstd.h.
+
+#ifndef PBRT_UTIL_HDPBRTGRAPH_H
+#define PBRT_UTIL_HDPBRTGRAPH_H
+
+#include <pbrt/pbrt.h>
+#include <pbrt/util/image.h>
+#include <pbrt/util/transform.h>
+#include <pbrt/util/vecmath.h>
+
+#include <array>
+#include <memory>
+#include <string>
+#include <vector>
+
+namespace pbrt {
+
+class HdPbrtGraph {
+  public:
+    using V4 = std::array<Float, 4>;
+
+    // One vertex: object-space position, normal and unit tangents, uv.
+    struct Vertex {
+        Point3f p;
+        Normal3f n;
+        Point2f uv;
+        Vector3f dpdu, dpdv;
+    };
+
+    // `images` are pairs of file name and encoding ("linear", "sRGB").
+    // Errors exit with `loc`.
+    static std::unique_ptr<HdPbrtGraph> Parse(const std::string &program,
+                                              const std::vector<std::string> &images,
+                                              const FileLoc *loc);
+
+    V4 Evaluate(const Vertex &v) const;
+
+    bool UsesTangents() const { return usesTangents; }
+    bool UsesWorld() const { return usesWorld; }
+    // For "world" space geometry (set by the shape before evaluating).
+    Transform worldFromObject;
+
+  private:
+    struct Instr {
+        int op = 0, dst = 0;
+        std::vector<int> a;
+    };
+    std::vector<Instr> code;
+    std::vector<V4> init;  // registers with constants
+    int out = 0;
+    bool usesTangents = false, usesWorld = false;
+    std::vector<std::shared_ptr<const Image>> images;
+};
+
+// MaterialX reference noise (exposed for tests).
+Float MxPerlin(Point2f p);
+Float MxPerlin(Point3f p);
+Vector3f MxPerlin3(Point2f p);
+Vector3f MxPerlin3(Point3f p);
+Float MxCellNoise(Point2f p);
+Float MxCellNoise(Point3f p);
+Vector3f MxCellNoise3(Point2f p);
+Vector3f MxCellNoise3(Point3f p);
+
+}  // namespace pbrt
+
+#endif  // PBRT_UTIL_HDPBRTGRAPH_H
