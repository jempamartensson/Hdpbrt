+// ---------------------------------------------------------------------------
+// MaterialX reference noise
+
+namespace {
+
+inline uint32_t Rotl32(uint32_t x, int k) {
+    return (x << k) | (x >> (32 - k));
+}
+
+inline void BjMix(uint32_t &a, uint32_t &b, uint32_t &c) {
+    a -= c; a ^= Rotl32(c, 4); c += b;
+    b -= a; b ^= Rotl32(a, 6); a += c;
+    c -= b; c ^= Rotl32(b, 8); b += a;
+    a -= c; a ^= Rotl32(c, 16); c += b;
+    b -= a; b ^= Rotl32(a, 19); a += c;
+    c -= b; c ^= Rotl32(b, 4); b += a;
+}
+
+inline uint32_t BjFinal(uint32_t a, uint32_t b, uint32_t c) {
+    c ^= b; c -= Rotl32(b, 14);
+    a ^= c; a -= Rotl32(c, 11);
+    b ^= a; b -= Rotl32(a, 25);
+    c ^= b; c -= Rotl32(b, 16);
+    a ^= c; a -= Rotl32(c, 4);
+    b ^= a; b -= Rotl32(a, 14);
+    c ^= b; c -= Rotl32(b, 24);
+    return c;
+}
+
+inline Float BitsTo01(uint32_t bits) {
+    return Float(double(bits) / double(0xffffffffu));
+}
+
+inline Float Fade(Float t) {
+    return t * t * t * (t * (t * 6 - 15) + 10);
+}
+
+inline int FloorI(Float x) {
+    return int(std::floor(x));
+}
+
+inline Float FloorFrac(Float x, int *i) {
+    *i = FloorI(x);
+    return x - Float(*i);
+}
+
+inline uint32_t HashInt(int x, int y) {
+    uint32_t a, b, c;
+    a = b = c = 0xdeadbeefu + (2u << 2u) + 13u;
+    a += uint32_t(x);
+    b += uint32_t(y);
+    return BjFinal(a, b, c);
+}
+
+inline uint32_t HashInt(int x, int y, int z) {
+    uint32_t a, b, c;
+    a = b = c = 0xdeadbeefu + (3u << 2u) + 13u;
+    a += uint32_t(x);
+    b += uint32_t(y);
+    c += uint32_t(z);
+    return BjFinal(a, b, c);
+}
+
+inline Float Select(bool b, Float t, Float f) {
+    return b ? t : f;
+}
+inline Float NegateIf(Float v, bool b) {
+    return b ? -v : v;
+}
+
+inline Float Gradient(uint32_t hash, Float x, Float y) {
+    uint32_t h = hash & 7u;
+    Float u = Select(h < 4u, x, y);
+    Float v = 2 * Select(h < 4u, y, x);
+    return NegateIf(u, h & 1u) + NegateIf(v, h & 2u);
+}
+
+inline Float Gradient(uint32_t hash, Float x, Float y, Float z) {
+    uint32_t h = hash & 15u;
+    Float u = Select(h < 8u, x, y);
+    Float v = Select(h < 4u, y, Select(h == 12u || h == 14u, x, z));
+    return NegateIf(u, h & 1u) + NegateIf(v, h & 2u);
+}
+
+inline Float Bilerp(Float v0, Float v1, Float v2, Float v3, Float s, Float t) {
+    Float s1 = 1 - s;
+    return (1 - t) * (v0 * s1 + v1 * s) + t * (v2 * s1 + v3 * s);
+}
+
+inline Float Trilerp(Float v0, Float v1, Float v2, Float v3, Float v4, Float v5, Float v6,
+                     Float v7, Float s, Float t, Float r) {
+    Float s1 = 1 - s, t1 = 1 - t, r1 = 1 - r;
+    return r1 * (t1 * (v0 * s1 + v1 * s) + t * (v2 * s1 + v3 * s)) +
+           r * (t1 * (v4 * s1 + v5 * s) + t * (v6 * s1 + v7 * s));
+}
+
+// Hash bytes for the vector noise: channel k is byte k of the hash.
+inline uint32_t Byte(uint32_t h, int k) {
+    return (h >> (8 * k)) & 0xFFu;
+}
+
+Float Perlin2(Point2f p, int channel) {
+    int X, Y;
+    Float fx = FloorFrac(p.x, &X), fy = FloorFrac(p.y, &Y);
+    Float u = Fade(fx), v = Fade(fy);
+    auto h = [&](int x, int y) {
+        uint32_t hh = HashInt(x, y);
+        return channel < 0 ? hh : Byte(hh, channel);
+    };
+    Float r = Bilerp(Gradient(h(X, Y), fx, fy), Gradient(h(X + 1, Y), fx - 1, fy),
+                     Gradient(h(X, Y + 1), fx, fy - 1),
+                     Gradient(h(X + 1, Y + 1), fx - 1, fy - 1), u, v);
+    return 0.6616f * r;
+}
+
+Float Perlin3(Point3f p, int channel) {
+    int X, Y, Z;
+    Float fx = FloorFrac(p.x, &X), fy = FloorFrac(p.y, &Y), fz = FloorFrac(p.z, &Z);
+    Float u = Fade(fx), v = Fade(fy), w = Fade(fz);
+    auto h = [&](int x, int y, int z) {
+        uint32_t hh = HashInt(x, y, z);
+        return channel < 0 ? hh : Byte(hh, channel);
+    };
+    Float r = Trilerp(Gradient(h(X, Y, Z), fx, fy, fz),
+                      Gradient(h(X + 1, Y, Z), fx - 1, fy, fz),
+                      Gradient(h(X, Y + 1, Z), fx, fy - 1, fz),
+                      Gradient(h(X + 1, Y + 1, Z), fx - 1, fy - 1, fz),
+                      Gradient(h(X, Y, Z + 1), fx, fy, fz - 1),
+                      Gradient(h(X + 1, Y, Z + 1), fx - 1, fy, fz - 1),
+                      Gradient(h(X, Y + 1, Z + 1), fx, fy - 1, fz - 1),
+                      Gradient(h(X + 1, Y + 1, Z + 1), fx - 1, fy - 1, fz - 1), u, v, w);
+    return 0.9820f * r;
+}
+
+Vector3f CellNoise3Ints(int ix, int iy, int iz) {
+    uint32_t a, b, c;
+    a = b = c = 0xdeadbeefu + (4u << 2u) + 13u;
+    a += uint32_t(ix);
+    b += uint32_t(iy);
+    c += uint32_t(iz);
+    BjMix(a, b, c);
+    return Vector3f(BitsTo01(BjFinal(a, b, c)), BitsTo01(BjFinal(a + 1u, b, c)),
+                    BitsTo01(BjFinal(a + 2u, b, c)));
+}
+
+// Worley: distances to the nearest three feature points (euclidean), or the
+// cell noise of the nearest (style 1; float cell noise in x when floatCell).
+Vector3f Worley2(Point2f p, Float jitter, int style, bool floatCell) {
+    int X, Y;
+    Point2f local(FloorFrac(p.x, &X), FloorFrac(p.y, &Y));
+    Float sq[3] = {1e6f, 1e6f, 1e6f};
+    Vector2f minpos(0, 0);
+    for (int x = -1; x <= 1; ++x)
+        for (int y = -1; y <= 1; ++y) {
+            Vector3f t = MxCellNoise3(Point2f(x + X, y + Y));
+            Vector2f off(t.x, t.y);
+            off = (off - Vector2f(0.5f, 0.5f)) * jitter + Vector2f(0.5f, 0.5f);
+            Vector2f cell = Vector2f(Float(x), Float(y)) + off - Vector2f(local);
+            Float d = Dot(cell, cell);
+            if (d < sq[0]) {
+                sq[2] = sq[1];
+                sq[1] = sq[0];
+                sq[0] = d;
+                minpos = cell;
+            } else if (d < sq[1]) {
+                sq[2] = sq[1];
+                sq[1] = d;
+            } else if (d < sq[2])
+                sq[2] = d;
+        }
+    if (style == 1) {
+        Point2f q(minpos.x + p.x, minpos.y + p.y);
+        return floatCell ? Vector3f(MxCellNoise(q), 0, 0) : MxCellNoise3(q);
+    }
+    return Vector3f(std::sqrt(sq[0]), std::sqrt(sq[1]), std::sqrt(sq[2]));
+}
+
+Vector3f Worley3(Point3f p, Float jitter, int style, bool floatCell) {
+    int X, Y, Z;
+    Point3f local(FloorFrac(p.x, &X), FloorFrac(p.y, &Y), FloorFrac(p.z, &Z));
+    Float sq[3] = {1e6f, 1e6f, 1e6f};
+    Vector3f minpos(0, 0, 0);
+    for (int x = -1; x <= 1; ++x)
+        for (int y = -1; y <= 1; ++y)
+            for (int z = -1; z <= 1; ++z) {
+                Vector3f off = CellNoise3Ints(x + X, y + Y, z + Z);
+                off = (off - Vector3f(0.5f, 0.5f, 0.5f)) * jitter + Vector3f(0.5f, 0.5f, 0.5f);
+                Vector3f cell = Vector3f(Float(x), Float(y), Float(z)) + off - Vector3f(local);
+                Float d = Dot(cell, cell);
+                if (d < sq[0]) {
+                    sq[2] = sq[1];
+                    sq[1] = sq[0];
+                    sq[0] = d;
+                    minpos = cell;
+                } else if (d < sq[1]) {
+                    sq[2] = sq[1];
+                    sq[1] = d;
+                } else if (d < sq[2])
+                    sq[2] = d;
+            }
+    if (style == 1)
+        return floatCell ? Vector3f(MxCellNoise(p + minpos), 0, 0) : MxCellNoise3(p + minpos);
+    return Vector3f(std::sqrt(sq[0]), std::sqrt(sq[1]), std::sqrt(sq[2]));
+}
+
+}  // namespace
+
+Float MxPerlin(Point2f p) {
+    return Perlin2(p, -1);
+}
+Float MxPerlin(Point3f p) {
+    return Perlin3(p, -1);
+}
+Vector3f MxPerlin3(Point2f p) {
+    return Vector3f(Perlin2(p, 0), Perlin2(p, 1), Perlin2(p, 2));
+}
+Vector3f MxPerlin3(Point3f p) {
+    return Vector3f(Perlin3(p, 0), Perlin3(p, 1), Perlin3(p, 2));
+}
+Float MxCellNoise(Point2f p) {
+    return BitsTo01(HashInt(FloorI(p.x), FloorI(p.y)));
+}
+Float MxCellNoise(Point3f p) {
+    return BitsTo01(HashInt(FloorI(p.x), FloorI(p.y), FloorI(p.z)));
+}
+Vector3f MxCellNoise3(Point2f p) {
+    int ix = FloorI(p.x), iy = FloorI(p.y);
+    return Vector3f(BitsTo01(HashInt(ix, iy, 0)), BitsTo01(HashInt(ix, iy, 1)),
+                    BitsTo01(HashInt(ix, iy, 2)));
+}
+Vector3f MxCellNoise3(Point3f p) {
+    return CellNoise3Ints(FloorI(p.x), FloorI(p.y), FloorI(p.z));
+}
+
