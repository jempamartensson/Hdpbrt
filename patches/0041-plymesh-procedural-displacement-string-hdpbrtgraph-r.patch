+
+std::mutex imageCacheMutex;
+std::map<std::string, std::shared_ptr<const Image>> imageCache;
+
+std::shared_ptr<const Image> LoadImage(const std::string &file, const std::string &encoding) {
+    std::string key = file + "|" + encoding;
+    std::lock_guard<std::mutex> lock(imageCacheMutex);
+    auto it = imageCache.find(key);
+    if (it != imageCache.end())
+        return it->second;
+    std::shared_ptr<const Image> img;
+    if (FileExists(file)) {
+        ImageAndMetadata im =
+            Image::Read(file, Allocator(), ColorEncoding::Get(encoding, Allocator()));
+        img = std::make_shared<Image>(std::move(im.image));
+    } else {
+        Warning("%s: displacement graph image not found.", file);
+    }
+    imageCache[key] = img;
+    return img;
+}
+
+inline HdPbrtGraph::V4 Broadcast(Float f) {
+    return {f, f, f, f};
+}
+
+WrapMode AddressMode(int m) {
+    // 0 periodic, 1 clamp, 2 constant (black; the default value is not
+    // blended), 3 mirror (as periodic)
+    return m == 1 ? WrapMode::Clamp : m == 2 ? WrapMode::Black : WrapMode::Repeat;
+}
+
+}  // namespace
+
+std::unique_ptr<HdPbrtGraph> HdPbrtGraph::Parse(const std::string &program,
+                                                const std::vector<std::string> &images,
+                                                const FileLoc *loc) {
+    auto g = std::make_unique<HdPbrtGraph>();
+    int maxReg = 0;
+    std::stringstream all(program);
+    std::string line;
+    while (std::getline(all, line, ';')) {
+        std::istringstream is(line);
+        std::string name;
+        if (!(is >> name))
+            continue;
+        if (name == "c") {
+            int dst;
+            V4 v;
+            if (!(is >> dst >> v[0] >> v[1] >> v[2] >> v[3]) || dst < 0)
+                ErrorExit(loc, "hdpbrtgraph: bad constant \"%s\".", line);
+            if (dst >= int(g->init.size()))
+                g->init.resize(dst + 1, V4{0, 0, 0, 0});
+            g->init[dst] = v;
+            maxReg = std::max(maxReg, dst);
+            continue;
+        }
+        if (name == "out") {
+            if (!(is >> g->out))
+                ErrorExit(loc, "hdpbrtgraph: bad output \"%s\".", line);
+            maxReg = std::max(maxReg, g->out);
+            continue;
+        }
+        const OpInfo *info = nullptr;
+        for (const OpInfo &o : kOps)
+            if (name == o.name)
+                info = &o;
+        if (!info)
+            ErrorExit(loc, "hdpbrtgraph: unknown op \"%s\".", name);
+        Instr in;
+        in.op = info->op;
+        if (!(is >> in.dst) || in.dst < 0)
+            ErrorExit(loc, "hdpbrtgraph: bad instruction \"%s\".", line);
+        int x;
+        while (is >> x)
+            in.a.push_back(x);
+        if (int(in.a.size()) < info->minArgs)
+            ErrorExit(loc, "hdpbrtgraph: too few operands in \"%s\".", line);
+        maxReg = std::max(maxReg, in.dst);
+        if (in.op == OpPos || in.op == OpNrm || in.op == OpTan3 || in.op == OpBtan) {
+            if (in.a[0] == 1)
+                g->usesWorld = true;
+            if (in.op == OpTan3 || in.op == OpBtan)
+                g->usesTangents = true;
+        }
+        if (in.op == OpImg && (in.a[0] < 0 || 2 * in.a[0] + 1 >= int(images.size())))
+            ErrorExit(loc, "hdpbrtgraph: bad image index in \"%s\".", line);
+        g->code.push_back(std::move(in));
+    }
+    for (size_t i = 0; i + 1 < images.size(); i += 2)
+        g->images.push_back(LoadImage(images[i], images[i + 1]));
+    g->init.resize(maxReg + 1, V4{0, 0, 0, 0});
+    return g;
+}
+
+HdPbrtGraph::V4 HdPbrtGraph::Evaluate(const Vertex &vx) const {
+    thread_local std::vector<V4> R;
+    R = init;
+    const int nr = int(R.size());
+    auto reg = [&](int i) -> const V4 & {
+        static const V4 zero{0, 0, 0, 0};
+        return i >= 0 && i < nr ? R[i] : zero;
+    };
+    auto vec3 = [&](int i) {
+        const V4 &v = reg(i);
+        return Vector3f(v[0], v[1], v[2]);
+    };
+    auto put3 = [](Vector3f v, Float w = 0) { return V4{v.x, v.y, v.z, w}; };
+    for (const Instr &in : code) {
+        const std::vector<int> &a = in.a;
+        V4 r{0, 0, 0, 0};
+        auto un = [&](auto f) {
+            const V4 &x = reg(a[0]);
+            for (int k = 0; k < 4; ++k)
+                r[k] = f(x[k]);
+        };
+        auto bin = [&](auto f) {
+            const V4 &x = reg(a[0]), &y = reg(a[1]);
+            for (int k = 0; k < 4; ++k)
+                r[k] = f(x[k], y[k]);
+        };
+        switch (in.op) {
+        case OpAbs: un([](Float x) { return std::abs(x); }); break;
+        case OpSign: un([](Float x) { return Float(x > 0 ? 1 : x < 0 ? -1 : 0); }); break;
+        case OpFloor: un([](Float x) { return std::floor(x); }); break;
+        case OpCeil: un([](Float x) { return std::ceil(x); }); break;
+        case OpRound: un([](Float x) { return std::round(x); }); break;
+        case OpFract: un([](Float x) { return x - std::floor(x); }); break;
+        case OpSin: un([](Float x) { return std::sin(x); }); break;
+        case OpCos: un([](Float x) { return std::cos(x); }); break;
+        case OpTan: un([](Float x) { return std::tan(x); }); break;
+        case OpAsin: un([](Float x) { return std::asin(x); }); break;
+        case OpAcos: un([](Float x) { return std::acos(x); }); break;
+        case OpSqrt: un([](Float x) { return std::sqrt(x); }); break;
+        case OpLn: un([](Float x) { return std::log(x); }); break;
+        case OpExp: un([](Float x) { return std::exp(x); }); break;
+        case OpAdd: bin([](Float x, Float y) { return x + y; }); break;
+        case OpSub: bin([](Float x, Float y) { return x - y; }); break;
+        case OpMul: bin([](Float x, Float y) { return x * y; }); break;
+        case OpDiv: bin([](Float x, Float y) { return x / y; }); break;
+        case OpMod: bin([](Float x, Float y) { return x - y * std::floor(x / y); }); break;
+        case OpPow: bin([](Float x, Float y) { return std::pow(x, y); }); break;
+        case OpMin: bin([](Float x, Float y) { return std::min(x, y); }); break;
+        case OpMax: bin([](Float x, Float y) { return std::max(x, y); }); break;
+        case OpAtan2: bin([](Float y, Float x) { return std::atan2(y, x); }); break;
+        case OpClamp: {
+            const V4 &x = reg(a[0]), &lo = reg(a[1]), &hi = reg(a[2]);
+            for (int k = 0; k < 4; ++k)
+                r[k] = std::min(std::max(x[k], lo[k]), hi[k]);
+            break;
+        }
+        case OpMix: {  // fg, bg, mix
+            const V4 &fg = reg(a[0]), &bg = reg(a[1]), &m = reg(a[2]);
+            for (int k = 0; k < 4; ++k)
+                r[k] = bg[k] + (fg[k] - bg[k]) * m[k];
+            break;
+        }
+        case OpSmooth: {  // in, low, high
+            const V4 &x = reg(a[0]), &lo = reg(a[1]), &hi = reg(a[2]);
+            for (int k = 0; k < 4; ++k) {
+                if (x[k] >= hi[k])
+                    r[k] = 1;
+                else if (x[k] <= lo[k])
+                    r[k] = 0;
+                else {
+                    Float t = (x[k] - lo[k]) / (hi[k] - lo[k]);
+                    r[k] = t * t * (3 - 2 * t);
+                }
+            }
+            break;
+        }
+        case OpRemap: {
+            const V4 &x = reg(a[0]), &il = reg(a[1]), &ih = reg(a[2]), &ol = reg(a[3]),
+                     &oh = reg(a[4]);
+            for (int k = 0; k < 4; ++k)
+                r[k] = ol[k] + (x[k] - il[k]) * (oh[k] - ol[k]) / (ih[k] - il[k]);
+            break;
+        }
+        case OpIfGt:
+        case OpIfGe:
+        case OpIfEq: {
+            Float v1 = reg(a[0])[0], v2 = reg(a[1])[0];
+            bool c = in.op == OpIfGt ? v1 > v2 : in.op == OpIfGe ? v1 >= v2 : v1 == v2;
+            r = reg(c ? a[2] : a[3]);
+            break;
+        }
+        case OpSwitch: {
+            int n = int(a.size()) - 1;
+            int w = int(std::floor(reg(a[0])[0]));
+            w = std::min(std::max(w, 0), n - 1);
+            r = reg(a[1 + w]);
+            break;
+        }
+        case OpDot:
+        case OpDist: {
+            const V4 &x = reg(a[0]), &y = reg(a[1]);
+            int w = std::min(std::max(a[2], 1), 4);
+            Float s = 0;
+            for (int k = 0; k < w; ++k)
+                s += in.op == OpDot ? x[k] * y[k] : Sqr(x[k] - y[k]);
+            r = Broadcast(in.op == OpDot ? s : std::sqrt(s));
+            break;
+        }
+        case OpLen:
+        case OpNorm: {
+            const V4 &x = reg(a[0]);
+            int w = std::min(std::max(a[1], 1), 4);
+            Float s = 0;
+            for (int k = 0; k < w; ++k)
+                s += x[k] * x[k];
+            s = std::sqrt(s);
+            if (in.op == OpLen)
+                r = Broadcast(s);
+            else
+                for (int k = 0; k < w; ++k)
+                    r[k] = s > 0 ? x[k] / s : 0;
+            break;
+        }
+        case OpCross:
+            r = put3(Cross(vec3(a[0]), vec3(a[1])));
+            break;
+        case OpExt:
+            r = Broadcast(reg(a[0])[std::min(std::max(a[1], 0), 3)]);
+            break;
+        case OpComb:
+            for (size_t k = 0; k < a.size() && k < 4; ++k)
+                r[k] = reg(a[k])[0];
+            break;
+        case OpCvt: {  // in, from width, to width
+            const V4 &x = reg(a[0]);
+            if (a[1] == 1)
+                r = Broadcast(x[0]);
+            else {
+                r = x;
+                for (int k = a[1]; k < 4; ++k)
+                    r[k] = (k == 3 && a[2] == 4) ? 1 : 0;
+            }
+            break;
+        }
+        case OpRot2: {  // in, degrees
+            const V4 &x = reg(a[0]);
+            Float t = Radians(reg(a[1])[0]), s = std::sin(t), c = std::cos(t);
+            r = {c * x[0] + s * x[1], -s * x[0] + c * x[1], 0, 0};
+            break;
+        }
+        case OpRot3: {  // in, degrees, axis
+            Vector3f v = vec3(a[0]), axis = vec3(a[2]);
+            if (LengthSquared(axis) > 0)
+                axis = Normalize(axis);
+            Float t = Radians(reg(a[1])[0]), s = std::sin(t), c = std::cos(t);
+            r = put3(v * c + Cross(v, axis) * s + axis * Dot(axis, v) * (1 - c));
+            break;
+        }
+        case OpPos:
+            r = put3(Vector3f(a[0] == 1 ? worldFromObject(vx.p) : vx.p));
+            break;
+        case OpNrm: {
+            Vector3f n(a[0] == 1 ? worldFromObject(vx.n) : vx.n);
+            r = put3(LengthSquared(n) > 0 ? Normalize(n) : n);
+            break;
+        }
+        case OpTan3:
+        case OpBtan: {
+            Vector3f t = in.op == OpTan3 ? vx.dpdu : vx.dpdv;
+            if (a[0] == 1)
+                t = worldFromObject(t);
+            r = put3(LengthSquared(t) > 0 ? Normalize(t) : t);
+            break;
+        }
+        case OpUV:
+            r = {vx.uv.x, vx.uv.y, 0, 0};
+            break;
+        case OpPerlin2:
+        case OpPerlin3: {  // position, output width (Karma's mxstd_noise)
+            const V4 &p = reg(a[0]);
+            const int w = a[1];
+            const bool three = in.op == OpPerlin3;
+            Point2f p2(p[0], p[1]);
+            Point3f p3(p[0], p[1], p[2]);
+            if (w == 1) {
+                r = Broadcast(three ? MxPerlin(p3) : MxPerlin(p2));
+            } else {
+                Vector3f v = three ? MxPerlin3(p3) : MxPerlin3(p2);
+                Float f = 0;
+                if (w == 4)
+                    f = three ? MxPerlin(p3 + Vector3f(19, 73, 29))
+                              : MxPerlin(p2 + Vector2f(19, 73));
+                r = put3(v, f);
+            }
+            break;
+        }
+        case OpFractal2:
+        case OpFractal3: {  // position, octaves, lacunarity, diminish, width
+            const V4 &p = reg(a[0]);
+            const int oct = int(reg(a[1])[0]);
+            const Float lac = reg(a[2])[0], dim = reg(a[3])[0];
+            const int w = a[4];
+            const bool three = in.op == OpFractal3;
+            auto fractalF = [&](Point3f q) {
+                Float res = 0, amp = 1;
+                for (int i = 0; i < oct; ++i) {
+                    res += amp * (three ? MxPerlin(q) : MxPerlin(Point2f(q.x, q.y)));
+                    amp *= dim;
+                    q = Point3f(q.x * lac, q.y * lac, q.z * lac);
+                }
+                return res;
+            };
+            auto fractalV = [&](Point3f q) {
+                Vector3f res(0, 0, 0);
+                Float amp = 1;
+                for (int i = 0; i < oct; ++i) {
+                    res += amp * (three ? MxPerlin3(q) : MxPerlin3(Point2f(q.x, q.y)));
+                    amp *= dim;
+                    q = Point3f(q.x * lac, q.y * lac, q.z * lac);
+                }
+                return res;
+            };
+            Point3f q(p[0], p[1], three ? p[2] : 0);
+            const Vector3f off = three ? Vector3f(19, 193, 17) : Vector3f(19, 193, 0);
+            if (w == 1)
+                r = Broadcast(fractalF(q));
+            else if (w == 2)
+                r = {fractalF(q), fractalF(q + off), 0, 0};
+            else
+                r = put3(fractalV(q), w == 4 ? fractalF(q + off) : 0);
+            break;
+        }
+        case OpCell2:
+        case OpCell3: {  // position, width
+            const V4 &p = reg(a[0]);
+            if (a[1] == 1)
+                r = Broadcast(in.op == OpCell3 ? MxCellNoise(Point3f(p[0], p[1], p[2]))
+                                               : MxCellNoise(Point2f(p[0], p[1])));
+            else
+                r = put3(in.op == OpCell3 ? MxCellNoise3(Point3f(p[0], p[1], p[2]))
+                                          : MxCellNoise3(Point2f(p[0], p[1])));
+            break;
+        }
+        case OpWorley2:
+        case OpWorley3: {  // position, jitter, style, width
+            const V4 &p = reg(a[0]);
+            const Float jitter = reg(a[1])[0];
+            const int style = int(reg(a[2])[0]);
+            const bool f = a[3] == 1;
+            Vector3f v = in.op == OpWorley3
+                             ? Worley3(Point3f(p[0], p[1], p[2]), jitter, style, f)
+                             : Worley2(Point2f(p[0], p[1]), jitter, style, f);
+            r = f ? Broadcast(v.x) : put3(v);
+            break;
+        }
+        case OpImg: {  // image, texcoord, default, width, uwrap, vwrap
+            const std::shared_ptr<const Image> &img = images[a[0]];
+            const V4 &st = reg(a[1]);
+            const V4 &def = reg(a[2]);
+            const int w = a[3];
+            if (!img) {
+                r = def;
+                break;
+            }
+            WrapMode2D wrap(AddressMode(a[4]), AddressMode(a[5]));
+            Point2f t(st[0], 1 - st[1]);
+            const int nc = img->NChannels();
+            for (int k = 0; k < w && k < 4; ++k) {
+                if (k >= nc)
+                    r[k] = (nc == 1 && k < 3) ? r[0] : (k == 3 ? 1 : 0);
+                else
+                    r[k] = img->BilerpChannel(t, k, wrap);
+            }
+            if (w == 1)
+                r = Broadcast(r[0]);
+            break;
+        }
+        case OpCopy:
+            r = reg(a[0]);
+            break;
+        }
+        if (in.dst < nr)
+            R[in.dst] = r;
+    }
+    return reg(out);
+}
+
+}  // namespace pbrt
