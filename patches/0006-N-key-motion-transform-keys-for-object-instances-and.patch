diff --git a/src/pbrt/cpu/primitive.cpp b/src/pbrt/cpu/primitive.cpp
index 44f258e..379ddb5 100644
--- a/src/pbrt/cpu/primitive.cpp
+++ b/src/pbrt/cpu/primitive.cpp
@@ -162,4 +162,49 @@ bool AnimatedPrimitive::IntersectP(const Ray &r, Float tMax) const {
     return primitive.IntersectP(ray, tMax);
 }
 
+// hdPbrt: MotionPrimitive Method Definitions
+MotionPrimitive::MotionPrimitive(Primitive p, std::vector<Transform> renderFromPrimitive,
+                                 std::vector<Float> t)
+    : primitive(p), times(std::move(t)) {
+    CHECK_GE(renderFromPrimitive.size(), 2);
+    CHECK_EQ(renderFromPrimitive.size(), times.size());
+    for (size_t k = 0; k + 1 < renderFromPrimitive.size(); ++k)
+        segments.push_back(AnimatedTransform(renderFromPrimitive[k], times[k],
+                                             renderFromPrimitive[k + 1], times[k + 1]));
+    primitiveMemory += sizeof(*this) + segments.size() * sizeof(AnimatedTransform);
+}
+
+Bounds3f MotionPrimitive::Bounds() const {
+    Bounds3f pb = primitive.Bounds(), b;
+    for (const AnimatedTransform &s : segments)
+        b = Union(b, s.MotionBounds(pb));
+    return b;
+}
+
+const AnimatedTransform &MotionPrimitive::Segment(Float time) const {
+    size_t k = 0;
+    while (k + 1 < segments.size() && times[k + 1] <= time)
+        ++k;
+    return segments[k];
+}
+
+pstd::optional<ShapeIntersection> MotionPrimitive::Intersect(const Ray &r,
+                                                             Float tMax) const {
+    Transform interpRenderFromPrimitive = Segment(r.time).Interpolate(r.time);
+    Ray ray = interpRenderFromPrimitive.ApplyInverse(r, &tMax);
+    pstd::optional<ShapeIntersection> si = primitive.Intersect(ray, tMax);
+    if (!si)
+        return {};
+    si->intr = interpRenderFromPrimitive(si->intr);
+    CHECK_GE(Dot(si->intr.n, si->intr.shading.n), 0);
+    if (hdpbrtInstanceId >= 0)
+        si->intr.hdpbrtInstanceId = hdpbrtInstanceId;
+    return si;
+}
+
+bool MotionPrimitive::IntersectP(const Ray &r, Float tMax) const {
+    Ray ray = Segment(r.time).ApplyInverse(r, &tMax);
+    return primitive.IntersectP(ray, tMax);
+}
+
 }  // namespace pbrt
