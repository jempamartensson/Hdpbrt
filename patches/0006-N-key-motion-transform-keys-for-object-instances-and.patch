 };
 
+// hdPbrt: MotionPrimitive Definition
+// A primitive moved by N >= 2 transform keys at increasing times. Between
+// neighboring keys it moves like an AnimatedPrimitive (decomposed translation,
+// rotation and scale), so many keys follow curved motion. Ray times outside
+// the keys clamp to the first or last key.
+class MotionPrimitive {
+  public:
+    MotionPrimitive(Primitive primitive, std::vector<Transform> renderFromPrimitive,
+                    std::vector<Float> times);
+    Bounds3f Bounds() const;
+    pstd::optional<ShapeIntersection> Intersect(const Ray &r, Float tMax) const;
+    bool IntersectP(const Ray &r, Float tMax) const;
+    void SetHdPbrtInstanceId(int id) { hdpbrtInstanceId = id; }
+
+  private:
+    const AnimatedTransform &Segment(Float time) const;
+
+    Primitive primitive;
+    std::vector<AnimatedTransform> segments;  // key k -> k + 1
+    std::vector<Float> times;
+    int hdpbrtInstanceId = -1;
+};
+
 }  // namespace pbrt
 
 #endif  // PBRT_CPU_PRIMITIVE_H
