+// hdPbrt: directional albedo of a GGX dielectric reflection lobe (single
+// scattering, unit weight), tabulated over cos(theta_o), sqrt(alpha) and eta.
+// HdPbrtInitDielectricAlbedo() must run (on the CPU) before lookups.
+void HdPbrtInitDielectricAlbedo();
+PBRT_CPU_GPU Float HdPbrtDielectricAlbedo(Float cosTheta, Float alpha, Float eta);
+
+// HdPbrtLayeredBxDF Definition
+// MaterialX/OpenPBR-style layering of a dielectric specular lobe over a
+// diffuse base, as USD's reference renderer and MaterialX's shaders do it:
+//   f = w * tint * f_ggx(F_dielectric) + (1 - w * E_spec(cos theta_o)) * R / pi
+// E_spec is the albedo of the untinted specular lobe for the outgoing
+// direction, so energy that the coat reflects is taken from the base (not
+// reciprocal, as in MaterialX). Two-sided.
+class HdPbrtLayeredBxDF {
+  public:
+    HdPbrtLayeredBxDF() = default;
+    PBRT_CPU_GPU
+    HdPbrtLayeredBxDF(SampledSpectrum R, SampledSpectrum specTint, Float specWeight,
+                      Float eta, TrowbridgeReitzDistribution mfDistrib)
+        : R(R), specTint(specTint), specWeight(specWeight), eta(eta),
+          mfDistrib(mfDistrib) {}
+
+    PBRT_CPU_GPU
+    BxDFFlags Flags() const {
+        BxDFFlags flags = R ? BxDFFlags::DiffuseReflection : BxDFFlags::Unset;
+        if (HasSpec())
+            flags = flags | (mfDistrib.EffectivelySmooth() ? BxDFFlags::SpecularReflection
+                                                           : BxDFFlags::GlossyReflection);
+        return flags;
+    }
+
+    PBRT_CPU_GPU
+    SampledSpectrum f(Vector3f wo, Vector3f wi, TransportMode mode) const {
+        if (!SameHemisphere(wo, wi) || wo.z == 0)
+            return SampledSpectrum(0.f);
+        if (wo.z < 0) {
+            wo = -wo;
+            wi = -wi;
+        }
+        SampledSpectrum result = R * (Throughput(wo) * InvPi);
+        if (HasSpec() && !mfDistrib.EffectivelySmooth())
+            result += SpecF(wo, wi);
+        return result;
+    }
+
+    PBRT_CPU_GPU
+    pstd::optional<BSDFSample> Sample_f(
+        Vector3f wo, Float uc, Point2f u, TransportMode mode,
+        BxDFReflTransFlags sampleFlags = BxDFReflTransFlags::All) const {
+        if (!(sampleFlags & BxDFReflTransFlags::Reflection) || wo.z == 0)
+            return {};
+        bool flip = wo.z < 0;
+        if (flip)
+            wo = -wo;
+        Float pSpec = SpecProb(wo);
+        if (pSpec == 0 && !R)
+            return {};
+        pstd::optional<BSDFSample> bs;
+        if (uc < pSpec) {
+            if (mfDistrib.EffectivelySmooth()) {
+                Vector3f wi(-wo.x, -wo.y, wo.z);
+                SampledSpectrum f =
+                    specTint * (specWeight * FrDielectric(wo.z, eta) / AbsCosTheta(wi));
+                bs = BSDFSample(f, wi, pSpec, BxDFFlags::SpecularReflection);
+            } else {
+                Vector3f wm = mfDistrib.Sample_wm(wo, u);
+                Vector3f wi = Reflect(wo, wm);
+                if (wi.z <= 0)
+                    return {};
+                bs = BSDFSample(f(wo, wi, mode), wi, PDFUpper(wo, wi, pSpec),
+                                BxDFFlags::GlossyReflection);
+            }
+        } else {
+            Vector3f wi = SampleCosineHemisphere(u);
+            if (wi.z <= 0)
+                return {};
+            bs = BSDFSample(f(wo, wi, mode), wi, PDFUpper(wo, wi, pSpec),
+                            BxDFFlags::DiffuseReflection);
+        }
+        if (flip)
+            bs->wi = -bs->wi;
+        return bs;
+    }
+
+    PBRT_CPU_GPU
+    Float PDF(Vector3f wo, Vector3f wi, TransportMode mode,
+              BxDFReflTransFlags sampleFlags = BxDFReflTransFlags::All) const {
+        if (!(sampleFlags & BxDFReflTransFlags::Reflection) || !SameHemisphere(wo, wi) ||
+            wo.z == 0)
+            return 0;
+        if (wo.z < 0) {
+            wo = -wo;
+            wi = -wi;
+        }
+        return PDFUpper(wo, wi, SpecProb(wo));
+    }
+
+    PBRT_CPU_GPU
+    static constexpr const char *Name() { return "HdPbrtLayeredBxDF"; }
+
+    std::string ToString() const;
+
+    PBRT_CPU_GPU
+    void Regularize() { mfDistrib.Regularize(); }
+
+  private:
+    PBRT_CPU_GPU
+    bool HasSpec() const { return specWeight > 0 && eta != 1 && bool(specTint); }
+
+    // Specular albedo for wo (upper hemisphere), untinted, unweighted.
+    PBRT_CPU_GPU
+    Float SpecAlbedo(Vector3f wo) const {
+        if (mfDistrib.EffectivelySmooth())
+            return FrDielectric(wo.z, eta);
+        return HdPbrtDielectricAlbedo(wo.z, mfDistrib.MeanAlpha(), eta);
+    }
+
+    PBRT_CPU_GPU
+    Float Throughput(Vector3f wo) const {
+        if (specWeight <= 0 || eta == 1)
+            return 1;
+        return Clamp(1 - specWeight * SpecAlbedo(wo), 0, 1);
+    }
+
+    // Probability of sampling the specular lobe.
+    PBRT_CPU_GPU
+    Float SpecProb(Vector3f wo) const {
+        if (!HasSpec())
+            return 0;
+        Float es = specWeight * SpecAlbedo(wo) * specTint.Average();
+        Float ed = Throughput(wo) * R.Average();
+        if (es + ed <= 0)
+            return 0;
+        // Keep both lobes sampled now and then.
+        return Clamp(es / (es + ed), 0.05f, ed > 0 ? 0.95f : 1.f);
+    }
+
+    PBRT_CPU_GPU
+    SampledSpectrum SpecF(Vector3f wo, Vector3f wi) const {
+        Float cosTheta_o = AbsCosTheta(wo), cosTheta_i = AbsCosTheta(wi);
+        if (cosTheta_i == 0 || cosTheta_o == 0)
+            return SampledSpectrum(0.f);
+        Vector3f wm = wi + wo;
+        if (LengthSquared(wm) == 0)
+            return SampledSpectrum(0.f);
+        wm = Normalize(wm);
+        Float F = FrDielectric(AbsDot(wo, wm), eta);
+        return specTint * (specWeight * mfDistrib.D(wm) * mfDistrib.G(wo, wi) * F /
+                           (4 * cosTheta_i * cosTheta_o));
+    }
+
+    // PDF for wo, wi in the upper hemisphere (non-delta lobes only).
+    PBRT_CPU_GPU
+    Float PDFUpper(Vector3f wo, Vector3f wi, Float pSpec) const {
+        if (wi.z <= 0)
+            return 0;
+        Float pdf = (1 - pSpec) * CosineHemispherePDF(wi.z);
+        if (pSpec > 0 && !mfDistrib.EffectivelySmooth()) {
+            Vector3f wm = Normalize(wo + wi);
+            pdf += pSpec * mfDistrib.PDF(wo, wm) / (4 * AbsDot(wo, wm));
+        }
+        return pdf;
+    }
+
+    SampledSpectrum R, specTint;
+    Float specWeight;
+    Float eta;
+    TrowbridgeReitzDistribution mfDistrib;
+};
+
 PBRT_CPU_GPU inline SampledSpectrum BxDF::f(Vector3f wo, Vector3f wi, TransportMode mode) const {
     auto f = [&](auto ptr) -> SampledSpectrum { return ptr->f(wo, wi, mode); };
     return Dispatch(f);
