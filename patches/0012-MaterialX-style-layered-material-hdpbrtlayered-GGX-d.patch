diff --git a/src/pbrt/util/scattering.h b/src/pbrt/util/scattering.h
index d5d6c63..2ac93f6 100644
--- a/src/pbrt/util/scattering.h
+++ b/src/pbrt/util/scattering.h
@@ -136,6 +136,10 @@ class TrowbridgeReitzDistribution {
     PBRT_CPU_GPU
     bool EffectivelySmooth() const { return std::max(alpha_x, alpha_y) < 1e-3f; }
 
+    // hdPbrt: the mean alpha (for albedo tables).
+    PBRT_CPU_GPU
+    Float MeanAlpha() const { return 0.5f * (alpha_x + alpha_y); }
+
     PBRT_CPU_GPU
     Float G1(Vector3f w) const { return 1 / (1 + Lambda(w)); }
 
