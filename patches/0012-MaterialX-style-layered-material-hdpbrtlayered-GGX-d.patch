+// hdPbrt: GGX dielectric reflection albedo table and HdPbrtLayeredBxDF.
+namespace {
+constexpr int kAlbedoCos = 33, kAlbedoRough = 33, kAlbedoEta = 25;
+constexpr Float kAlbedoEtaMax = 4;
+float hdpbrtAlbedo[kAlbedoEta][kAlbedoRough][kAlbedoCos];
+std::once_flag hdpbrtAlbedoOnce;
+
+Float AlbedoEtaAt(int i) {
+    // Denser near eta 1, where the albedo changes fastest.
+    Float t = Float(i) / (kAlbedoEta - 1);
+    return 1 + (kAlbedoEtaMax - 1) * t * t;
+}
+}  // namespace
+
+void HdPbrtInitDielectricAlbedo() {
+    std::call_once(hdpbrtAlbedoOnce, [] {
+        constexpr int n = 48;  // n x n stratified VNDF samples per entry
+        ParallelFor(0, kAlbedoEta, [&](int64_t ie) {
+            Float eta = AlbedoEtaAt(ie);
+            for (int ir = 0; ir < kAlbedoRough; ++ir) {
+                Float r = Float(ir) / (kAlbedoRough - 1);
+                Float alpha = std::max<Float>(r * r, 1e-4f);
+                TrowbridgeReitzDistribution distrib(alpha, alpha);
+                for (int ic = 0; ic < kAlbedoCos; ++ic) {
+                    Float c = std::max<Float>(Float(ic) / (kAlbedoCos - 1), 1e-3f);
+                    if (eta == 1) {
+                        hdpbrtAlbedo[ie][ir][ic] = 0;
+                        continue;
+                    }
+                    if (distrib.EffectivelySmooth()) {
+                        hdpbrtAlbedo[ie][ir][ic] = FrDielectric(c, eta);
+                        continue;
+                    }
+                    Vector3f wo(SafeSqrt(1 - c * c), 0, c);
+                    double sum = 0;
+                    for (int a = 0; a < n; ++a)
+                        for (int b = 0; b < n; ++b) {
+                            Point2f u((a + 0.5f) / n, (b + 0.5f) / n);
+                            Vector3f wm = distrib.Sample_wm(wo, u);
+                            Vector3f wi = Reflect(wo, wm);
+                            if (wi.z <= 0)
+                                continue;
+                            // f cos / pdf for VNDF sampling = F G2 / G1(wo)
+                            sum += FrDielectric(AbsDot(wo, wm), eta) *
+                                   distrib.G(wo, wi) / distrib.G1(wo);
+                        }
+                    hdpbrtAlbedo[ie][ir][ic] = float(sum / (n * n));
+                }
+            }
+        });
+    });
+}
+
+PBRT_CPU_GPU Float HdPbrtDielectricAlbedo(Float cosTheta, Float alpha, Float eta) {
+    if (eta < 1)
+        eta = 1 / eta;
+    eta = Clamp(eta, 1, kAlbedoEtaMax);
+    Float fe = std::sqrt((eta - 1) / (kAlbedoEtaMax - 1)) * (kAlbedoEta - 1);
+    Float fr = Clamp(std::sqrt(std::max<Float>(alpha, 0)), 0, 1) * (kAlbedoRough - 1);
+    Float fc = Clamp(cosTheta, 0, 1) * (kAlbedoCos - 1);
+    int e0 = std::min(int(fe), kAlbedoEta - 2), r0 = std::min(int(fr), kAlbedoRough - 2),
+        c0 = std::min(int(fc), kAlbedoCos - 2);
+    Float te = fe - e0, tr = fr - r0, tc = fc - c0;
+    auto at = [&](int e, int r) {
+        return Lerp(tc, Float(hdpbrtAlbedo[e][r][c0]), Float(hdpbrtAlbedo[e][r][c0 + 1]));
+    };
+    return Lerp(te, Lerp(tr, at(e0, r0), at(e0, r0 + 1)),
+                Lerp(tr, at(e0 + 1, r0), at(e0 + 1, r0 + 1)));
+}
+
+std::string HdPbrtLayeredBxDF::ToString() const {
+    return StringPrintf("[ HdPbrtLayeredBxDF R: %s specTint: %s specWeight: %f eta: %f "
+                        "mfDistrib: %s ]",
+                        R, specTint, specWeight, eta, mfDistrib);
+}
