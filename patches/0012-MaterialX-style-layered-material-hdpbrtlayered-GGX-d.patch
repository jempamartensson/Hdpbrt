+// HdPbrtLayeredMaterial Definition
+// hdPbrt: a dielectric specular layer over a diffuse base, MaterialX style
+// (see HdPbrtLayeredBxDF).
+class HdPbrtLayeredMaterial {
+  public:
+    using BxDF = HdPbrtLayeredBxDF;
+    using BSSRDF = void;
+
+    HdPbrtLayeredMaterial(SpectrumTexture reflectance, SpectrumTexture specTint,
+                          FloatTexture specWeight, FloatTexture uRoughness,
+                          FloatTexture vRoughness, Float eta, FloatTexture displacement,
+                          Image *normalMap, bool remapRoughness)
+        : displacement(displacement),
+          normalMap(normalMap),
+          reflectance(reflectance),
+          specTint(specTint),
+          specWeight(specWeight),
+          uRoughness(uRoughness),
+          vRoughness(vRoughness),
+          eta(eta),
+          remapRoughness(remapRoughness) {}
+
+    static const char *Name() { return "HdPbrtLayeredMaterial"; }
+
+    template <typename TextureEvaluator>
+    PBRT_CPU_GPU bool CanEvaluateTextures(TextureEvaluator texEval) const {
+        return texEval.CanEvaluate({uRoughness, vRoughness, specWeight},
+                                   {reflectance, specTint});
+    }
+
+    template <typename TextureEvaluator>
+    PBRT_CPU_GPU HdPbrtLayeredBxDF GetBxDF(TextureEvaluator texEval,
+                                           const MaterialEvalContext &ctx,
+                                           SampledWavelengths &lambda) const {
+        SampledSpectrum r = Clamp(texEval(reflectance, ctx, lambda), 0, 1);
+        SampledSpectrum tint = Clamp(texEval(specTint, ctx, lambda), 0, 1);
+        Float w = Clamp(texEval(specWeight, ctx), 0, 1);
+        Float urough = texEval(uRoughness, ctx), vrough = texEval(vRoughness, ctx);
+        if (remapRoughness) {
+            urough = TrowbridgeReitzDistribution::RoughnessToAlpha(urough);
+            vrough = TrowbridgeReitzDistribution::RoughnessToAlpha(vrough);
+        }
+        return HdPbrtLayeredBxDF(r, tint, w, eta,
+                                 TrowbridgeReitzDistribution(urough, vrough));
+    }
+
+    PBRT_CPU_GPU
+    FloatTexture GetDisplacement() const { return displacement; }
+    PBRT_CPU_GPU
+    const Image *GetNormalMap() const { return normalMap; }
+
+    static HdPbrtLayeredMaterial *Create(const TextureParameterDictionary &parameters,
+                                         Image *normalMap, const FileLoc *loc,
+                                         Allocator alloc);
+
+    template <typename TextureEvaluator>
+    PBRT_CPU_GPU void GetBSSRDF(TextureEvaluator texEval, const MaterialEvalContext &ctx,
+                                SampledWavelengths &lambda) const {}
+
+    PBRT_CPU_GPU static constexpr bool HasSubsurfaceScattering() { return false; }
+
+    std::string ToString() const;
+
+  private:
+    FloatTexture displacement;
+    Image *normalMap;
+    SpectrumTexture reflectance, specTint;
+    FloatTexture specWeight, uRoughness, vRoughness;
+    Float eta;
+    bool remapRoughness;
+};
+
 // CoatedConductorMaterial Definition
