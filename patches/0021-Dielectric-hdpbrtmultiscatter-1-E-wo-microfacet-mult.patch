 }
 
+PBRT_CPU_GPU Float DielectricBxDF::MultiScatterScale(Vector3f wo) const {
+    if (!multiScatter)
+        return 1;
+    Float etaRel = CosTheta(wo) > 0 ? eta : 1 / eta;
+    Float E = HdPbrtDielectricRTAlbedo(AbsCosTheta(wo), mfDistrib.MeanAlpha(), etaRel);
+    return 1 / std::max<Float>(E, 0.1f);
+}
+
 std::string DielectricBxDF::ToString() const {
     return StringPrintf("[ DielectricBxDF eta: %f mfDistrib: %s ]", eta,
                         mfDistrib.ToString());
@@ -1183,6 +1191,8 @@ namespace {
 constexpr int kAlbedoCos = 33, kAlbedoRough = 33, kAlbedoEta = 25;
 constexpr Float kAlbedoEtaMax = 4;
 float hdpbrtAlbedo[kAlbedoEta][kAlbedoRough][kAlbedoCos];
+// [0]: etaRel >= 1 (outside), [1]: etaRel = 1 / eta (inside), same eta axis.
+float hdpbrtRTAlbedo[2][kAlbedoEta][kAlbedoRough][kAlbedoCos];
 constexpr int kSheenCos = 33, kSheenAlpha = 33;
 float hdpbrtSheenAlbedo[kSheenAlpha][kSheenCos];
 std::once_flag hdpbrtAlbedoOnce;
@@ -1205,6 +1215,8 @@ void HdPbrtInitDielectricAlbedo() {
                 TrowbridgeReitzDistribution distrib(alpha, alpha);
                 for (int ic = 0; ic < kAlbedoCos; ++ic) {
                     Float c = std::max<Float>(Float(ic) / (kAlbedoCos - 1), 1e-3f);
+                    // eta 1 and smooth interfaces lose nothing.
+                    hdpbrtRTAlbedo[0][ie][ir][ic] = hdpbrtRTAlbedo[1][ie][ir][ic] = 1;
                     if (eta == 1) {
                         hdpbrtAlbedo[ie][ir][ic] = 0;
                         continue;
@@ -1227,6 +1239,28 @@ void HdPbrtInitDielectricAlbedo() {
                                    distrib.G(wo, wi) / distrib.G1(wo);
                         }
                     hdpbrtAlbedo[ie][ir][ic] = float(sum / (n * n));
+                    // R + T from both sides, VNDF sampled: per microfacet
+                    // normal, F G2 / G1 for reflection, (1 - F) G2 / G1 for
+                    // transmission (energy, no 1/eta^2).
+                    for (int side = 0; side < 2; ++side) {
+                        Float etaRel = side == 0 ? eta : 1 / eta;
+                        double e = 0;
+                        for (int a = 0; a < n; ++a)
+                            for (int b = 0; b < n; ++b) {
+                                Point2f u((a + 0.5f) / n, (b + 0.5f) / n);
+                                Vector3f wm = distrib.Sample_wm(wo, u);
+                                Float F = FrDielectric(Dot(wo, wm), etaRel);
+                                Vector3f wr = Reflect(wo, wm);
+                                if (wr.z > 0)
+                                    e += F * distrib.G(wo, wr) / distrib.G1(wo);
+                                Vector3f wt;
+                                Float etap;
+                                if (F < 1 && Refract(wo, (Normal3f)wm, etaRel, &etap, &wt) &&
+                                    wt.z < 0)
+                                    e += (1 - F) * distrib.G(wo, wt) / distrib.G1(wo);
+                            }
+                        hdpbrtRTAlbedo[side][ie][ir][ic] = float(std::min(e / (n * n), 1.0));
+                    }
                 }
             }
         });
@@ -1271,6 +1305,24 @@ PBRT_CPU_GPU Float HdPbrtDielectricAlbedo(Float cosTheta, Float alpha, Float eta
                 Lerp(tr, at(e0 + 1, r0), at(e0 + 1, r0 + 1)));
 }
 
+PBRT_CPU_GPU Float HdPbrtDielectricRTAlbedo(Float cosTheta, Float alpha, Float etaRel) {
+    int side = etaRel < 1 ? 1 : 0;
+    Float eta = side ? 1 / etaRel : etaRel;
+    eta = Clamp(eta, 1, kAlbedoEtaMax);
+    Float fe = std::sqrt((eta - 1) / (kAlbedoEtaMax - 1)) * (kAlbedoEta - 1);
+    Float fr = Clamp(std::sqrt(std::max<Float>(alpha, 0)), 0, 1) * (kAlbedoRough - 1);
+    Float fc = Clamp(cosTheta, 0, 1) * (kAlbedoCos - 1);
+    int e0 = std::min(int(fe), kAlbedoEta - 2), r0 = std::min(int(fr), kAlbedoRough - 2),
+        c0 = std::min(int(fc), kAlbedoCos - 2);
+    Float te = fe - e0, tr = fr - r0, tc = fc - c0;
+    auto at = [&](int e, int r) {
+        return Lerp(tc, Float(hdpbrtRTAlbedo[side][e][r][c0]),
+                    Float(hdpbrtRTAlbedo[side][e][r][c0 + 1]));
+    };
+    return Lerp(te, Lerp(tr, at(e0, r0), at(e0, r0 + 1)),
+                Lerp(tr, at(e0 + 1, r0), at(e0 + 1, r0 + 1)));
+}
