diff --git a/src/pbrt/util/mesh.h b/src/pbrt/util/mesh.h
index 95d3080..f8efc93 100644
--- a/src/pbrt/util/mesh.h
+++ b/src/pbrt/util/mesh.h
@@ -44,6 +44,27 @@ class TriangleMesh {
     const Point2f *uv = nullptr;
     const int *faceIndices = nullptr;
     bool reverseOrientation, transformSwapsHandedness;
+
+    // hdPbrt: deformation motion blur. When p1 is set, the vertex positions
+    // (and normals, when n1 is set) move linearly from p/n at time0 to p1/n1
+    // at time1; ray times outside that range clamp to the end poses.
+    const Point3f *p1 = nullptr;
+    const Normal3f *n1 = nullptr;
+    Float time0 = 0, time1 = 1;
+    // p1/n1 are in object space, like the constructor's p and n. n1 may be empty.
+    void SetMotion(const Transform &renderFromObject, std::vector<Point3f> p1,
+                   std::vector<Normal3f> n1, Float time0, Float time1, Allocator alloc);
+    // Interpolation factor in [0, 1] for a ray time.
+    PBRT_CPU_GPU
+    Float MotionFactor(Float time) const {
+        if (!p1 || time1 <= time0)
+            return 0;
+        return Clamp((time - time0) / (time1 - time0), 0, 1);
+    }
+    PBRT_CPU_GPU
+    Point3f P(int i, Float f) const { return p1 ? p[i] + f * (p1[i] - p[i]) : p[i]; }
+    PBRT_CPU_GPU
+    Normal3f N(int i, Float f) const { return n1 ? n[i] + f * (n1[i] - n[i]) : n[i]; }
 };
 
