+void TriangleMesh::SetMotion(const Transform &renderFromObject, std::vector<Point3f> P1,
+                             std::vector<Normal3f> N1, Float t0, Float t1,
+                             Allocator alloc) {
+    // hdPbrt: deformation motion blur (see mesh.h).
+    if (P1.size() != size_t(nVertices))
+        return;
+    for (Point3f &pt : P1)
+        pt = renderFromObject(pt);
+    p1 = point3BufferCache->LookupOrAdd(P1, alloc);
+    if (n && N1.size() == size_t(nVertices)) {
+        for (Normal3f &nn : N1) {
+            nn = renderFromObject(nn);
+            if (reverseOrientation)
+                nn = -nn;
+        }
+        n1 = normal3BufferCache->LookupOrAdd(N1, alloc);
+    }
+    time0 = t0;
+    time1 = t1;
+}
