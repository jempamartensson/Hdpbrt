From e11c98c15285519ba1c1bc72c8e583765c087bab Mon Sep 17 00:00:00 2001
From: jempa <jempamartensson@gmail.com>
Date: Sun, 22 Nov 2026 14:06:20 +0100
Subject: [PATCH 01/42] pbrt: exit when PBRT_PARENT_PID's process goes away
 (for hdPbrt)

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 src/pbrt/cmd/pbrt.cpp | 15 +++++++++++++++
 1 file changed, 15 insertions(+)

diff --git a/src/pbrt/cmd/pbrt.cpp b/src/pbrt/cmd/pbrt.cpp
index 2cc9d61..41bf51f 100644
--- a/src/pbrt/cmd/pbrt.cpp
+++ b/src/pbrt/cmd/pbrt.cpp
@@ -23,6 +23,9 @@
 #include <pbrt/wavefront/wavefront.h>
 
 #include <string>
+#include <thread>
+#include <chrono>
+#include <unistd.h>
 #include <vector>
 
 using namespace pbrt;
@@ -269,6 +272,18 @@ int main(int argc, char *argv[]) {
 
     options.logLevel = LogLevelFromString(logLevel);
 
+    // hdPbrt: when launched by the Hydra delegate, exit if the parent process dies
+    if (const char *pp = getenv("PBRT_PARENT_PID")) {
+        pid_t parent = (pid_t)atoi(pp);
+        std::thread([parent]() {
+            while (true) {
+                std::this_thread::sleep_for(std::chrono::milliseconds(500));
+                if (getppid() != parent)
+                    std::_Exit(2);
+            }
+        }).detach();
+    }
+
     // Initialize pbrt
     InitPBRT(options);
 
-- 
