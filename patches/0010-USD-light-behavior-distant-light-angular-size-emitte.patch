 src/pbrt/lights.cpp          | 16 ++++++++++-
 src/pbrt/lights.h            | 54 +++++++++++++++++++++++++++++++-----
 src/pbrt/scene.cpp           |  7 +++--
 4 files changed, 77 insertions(+), 10 deletions(-)

