 // PointLight Definition
@@ -311,10 +319,16 @@ class PointLight : public LightBase {
 class DistantLight : public LightBase {
   public:
     // DistantLight Public Methods
-    DistantLight(const Transform &renderFromLight, Spectrum Lemit, Float scale)
-        : LightBase(LightType::DeltaDirection, renderFromLight, {}),
+    // hdPbrt: cosThetaMax < 1 gives the light an angular size (a cone of
+    // directions around its axis, like the sun), which makes it an
+    // infinite light that BSDF-sampled rays can hit.
+    DistantLight(const Transform &renderFromLight, Spectrum Lemit, Float scale,
+                 Float cosThetaMax = 1)
+        : LightBase(cosThetaMax < 1 ? LightType::Infinite : LightType::DeltaDirection,
+                    renderFromLight, {}),
           Lemit(LookupSpectrum(Lemit)),
-          scale(scale) {}
+          scale(scale),
+          cosThetaMax(cosThetaMax) {}
 
     static DistantLight *Create(const Transform &renderFromLight,
                                 const ParameterDictionary &parameters,
@@ -324,8 +338,21 @@ class DistantLight : public LightBase {
     SampledSpectrum Phi(SampledWavelengths lambda) const;
 
     PBRT_CPU_GPU
-    Float PDF_Li(LightSampleContext, Vector3f, bool allowIncompletePDF) const {
-        return 0;
+    Float PDF_Li(LightSampleContext, Vector3f wi, bool allowIncompletePDF) const {
+        if (cosThetaMax >= 1)
+            return 0;
+        // hdPbrt: angular size
+        Vector3f wl = Normalize(renderFromLight.ApplyInverse(wi));
+        return wl.z >= cosThetaMax ? UniformConePDF(cosThetaMax) : 0;
+    }
+
+    // hdPbrt: radiance toward an escaping ray inside the light's cone.
+    PBRT_CPU_GPU
+    SampledSpectrum Le(const Ray &ray, const SampledWavelengths &lambda) const {
+        if (cosThetaMax >= 1)
+            return SampledSpectrum(0.f);
+        Vector3f wl = Normalize(renderFromLight.ApplyInverse(ray.d));
+        return wl.z >= cosThetaMax ? scale * Lemit->Sample(lambda) : SampledSpectrum(0.f);
     }
 
     PBRT_CPU_GPU
@@ -351,6 +378,14 @@ class DistantLight : public LightBase {
     pstd::optional<LightLiSample> SampleLi(LightSampleContext ctx, Point2f u,
                                            SampledWavelengths lambda,
                                            bool allowIncompletePDF) const {
+        if (cosThetaMax < 1) {
+            // hdPbrt: uniform sample of the light's cone of directions.
+            Vector3f wi = Normalize(renderFromLight(SampleUniformCone(u, cosThetaMax)));
+            Point3f pOutside = ctx.p() + wi * (2 * sceneRadius);
+            return LightLiSample(scale * Lemit->Sample(lambda), wi,
+                                 UniformConePDF(cosThetaMax),
+                                 Interaction(pOutside, nullptr));
+        }
         Vector3f wi = Normalize(renderFromLight(Vector3f(0, 0, 1)));
         Point3f pOutside = ctx.p() + wi * (2 * sceneRadius);
         return LightLiSample(scale * Lemit->Sample(lambda), wi, 1,
@@ -361,6 +396,7 @@ class DistantLight : public LightBase {
     // DistantLight Private Members
     const DenselySampledSpectrum *Lemit;
     Float scale;
+    Float cosThetaMax = 1;  // hdPbrt
     Point3f sceneCenter;
     Float sceneRadius;
 };
