             RGB rgb;
             uv[1] = 1 - uv[1];
             for (int c = 0; c < 3; ++c)
-                rgb[c] = image.BilerpChannel(uv, c);
+                rgb[c] = image.BilerpChannel(uv, c) * hdpbrtTint[c];
             RGBIlluminantSpectrum spec(*imageColorSpace, ClampZero(rgb));
             Le = scale * spec.Sample(lambda);
 
@@ -534,6 +570,10 @@ class DiffuseAreaLight : public LightBase {
     }
 
