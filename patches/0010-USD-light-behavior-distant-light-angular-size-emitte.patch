                     continue;
+                // hdPbrt: camera rays don't see a distant light's disc.
+                if (depth == 0 && light.Is<DistantLight>())
+                    continue;
                 if (SampledSpectrum Le = light.Le(ray, lambda); Le) {
                     if (depth == 0 || specularBounce)
                         L += beta * Le / r_u.Average();
@@ -1159,6 +1162,13 @@ SampledSpectrum VolPathIntegrator::Li(RayDifferential ray, SampledWavelengths &l
         if (Le && depth > 0 && isect.areaLight &&
             !HdPbrtLit(Light(isect.areaLight), prevLinkMask))
             Le = SampledSpectrum(0.f);
+        // hdPbrt: emitters hidden from the camera
+        if (Le && depth == 0 && isect.areaLight) {
+            const DiffuseAreaLight *dl =
+                Light(isect.areaLight).CastOrNullptr<DiffuseAreaLight>();
+            if (dl && !dl->hdpbrtCameraVisible)
+                Le = SampledSpectrum(0.f);
+        }
         if (Le) {
             // Add contribution of emission from intersected surface
             if (depth == 0 || specularBounce)
diff --git a/src/pbrt/lights.cpp b/src/pbrt/lights.cpp
index 11dc637..e5262ae 100644
--- a/src/pbrt/lights.cpp
+++ b/src/pbrt/lights.cpp
@@ -243,6 +243,12 @@ HdPbrtShaping HdPbrtShaping::Create(const ParameterDictionary &parameters,
                                                 : im.image.GetChannelDesc({"R"}),
                                             alloc);
     }
+    std::vector<Float> frame = parameters.GetFloatArray("shapingframe");
+    if (frame.size() == 9) {
+        s.hasFrame = true;
+        for (int i = 0; i < 9; ++i)
+            s.frame[i] = frame[i];
+    }
     s.active = s.focus > 0 || s.coneCutoff < Pi || bool(s.ies);
     return s;
 }
@@ -307,7 +313,11 @@ DistantLight *DistantLight::Create(const Transform &renderFromLight,
     if (E_v > 0)
         sc *= E_v;
 
-    return alloc.new_object<DistantLight>(finalRenderFromLight, L, sc);
+    // hdPbrt: "float hdpbrtangle", the angular diameter in degrees (0 = a
+    // single direction). The radiance inside the cone is L (in nits).
+    Float angle = Clamp(parameters.GetOneFloat("hdpbrtangle", 0), 0, 360);
+    Float cosThetaMax = angle > 0 ? std::cos(Radians(angle) / 2) : 1;
+    return alloc.new_object<DistantLight>(finalRenderFromLight, L, sc, cosThetaMax);
 }
 
 STAT_MEMORY_COUNTER("Memory/Light image and distributions", imageBytes);
@@ -975,6 +985,10 @@ DiffuseAreaLight *DiffuseAreaLight::Create(const Transform &renderFromLight,
                                               alphaTex, std::move(image), imageColorSpace,
                                               twoSided);
     light->shaping = HdPbrtShaping::Create(parameters, colorSpace, loc, alloc);  // hdPbrt
+    light->hdpbrtCameraVisible = parameters.GetOneBool("hdpbrtcamera", true);  // hdPbrt
+    std::vector<RGB> tint = parameters.GetRGBArray("hdpbrttint");               // hdPbrt
+    if (!tint.empty())
+        light->hdpbrtTint = tint[0];
     return light;
 }
 
diff --git a/src/pbrt/lights.h b/src/pbrt/lights.h
