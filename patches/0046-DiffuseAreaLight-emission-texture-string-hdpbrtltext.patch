+void DiffuseAreaLight::SetHdPbrtTexture(SpectrumTexture tex) {
+    hdpbrtLTex = tex;
+    hdpbrtLMax = hdpbrtLAvg = 0;
+    if (!tex)
+        return;
+    // A few points of the shape (near the corners of a triangle, its middle,
+    // and some others) at a few wavelengths: the power for light sampling.
+    // Never 0 where the shape may emit, so it keeps being sampled.
+    const Point2f us[] = {{0.02f, 0.02f}, {0.98f, 0.02f}, {0.02f, 0.98f}, {0.5f, 0.5f},
+                          {0.25f, 0.75f}, {0.75f, 0.25f}, {0.3f, 0.3f}, {0.7f, 0.7f}};
+    int n = 0;
+    for (Point2f u : us) {
+        pstd::optional<ShapeSample> ss = shape.Sample(u);
+        if (!ss)
+            continue;
+        TextureEvalContext ctx;
+        ctx.p = ss->intr.p();
+        ctx.n = ss->intr.n;
+        ctx.uv = ss->intr.uv;
+        ctx.hdpbrtPrimvars = ss->hdpbrtPrimvars;
+        for (Float l : {0.1f, 0.5f, 0.9f}) {
+            SampledWavelengths lambda = SampledWavelengths::SampleVisible(l);
+            SampledSpectrum s = ClampZero(UniversalTextureEvaluator()(tex, ctx, lambda));
+            hdpbrtLMax = std::max(hdpbrtLMax, s.MaxComponentValue());
+            hdpbrtLAvg += s.Average();
+            ++n;
+        }
+    }
+    if (n)
+        hdpbrtLAvg /= n;
+    // Lights brighter than the samples show still need some power.
+    hdpbrtLMax = std::max(hdpbrtLMax, Float(1e-3));
+    hdpbrtLAvg = std::max(hdpbrtLAvg, Float(1e-3));
+}
+
 SampledSpectrum DiffuseAreaLight::Phi(SampledWavelengths lambda) const {
     SampledSpectrum L(0.f);
     if (image) {
@@ -847,7 +883,9 @@ SampledSpectrum DiffuseAreaLight::Phi(SampledWavelengths lambda) const {
             }
         L *= scale / (image.Resolution().x * image.Resolution().y);
 
-    } else
+    } else if (hdpbrtLTex)
+        L = SampledSpectrum(hdpbrtLAvg * scale);  // estimate (hdPbrt)
+    else
         L = Lemit->Sample(lambda) * scale;
     return Pi * (twoSided ? 2 : 1) * area * L;
 }
@@ -864,7 +902,9 @@ pstd::optional<LightBounds> DiffuseAreaLight::Bounds() const {
                     phi += image.GetChannel({x, y}, c);
         phi /= 3 * image.Resolution().x * image.Resolution().y;
 
-    } else
+    } else if (hdpbrtLTex)
+        phi = hdpbrtLMax;  // estimate (hdPbrt)
+    else
         phi = Lemit->MaxValue();
     phi *= scale * area * Pi;
 
