 // DielectricBxDF Definition
 class DielectricBxDF {
   public:
@@ -235,6 +264,17 @@ class DielectricBxDF {
     Float PDF(Vector3f wo, Vector3f wi, TransportMode mode,
               BxDFReflTransFlags sampleFlags = BxDFReflTransFlags::All) const;
 
+    // hdPbrt: a thin film on the outside of the interface (weight,
+    // thickness in nm, film index, the sampled wavelengths in nm).
+    PBRT_CPU_GPU
+    void SetFilm(Float weight, Float thicknessNm, Float filmEta_,
+                 const SampledSpectrum &lambdaNm) {
+        filmWeight = Clamp(weight, 0, 1);
+        filmThickness = std::max<Float>(thicknessNm, 0);
+        filmEta = filmEta_;
+        filmLambda = lambdaNm;
+    }
+
     PBRT_CPU_GPU
     static constexpr const char *Name() { return "DielectricBxDF"; }
 
@@ -258,6 +298,32 @@ class DielectricBxDF {
     // (as Typhoon's coupled dielectric interface does).
     bool multiScatter = false;
     PBRT_CPU_GPU Float MultiScatterScale(Vector3f wo) const;
+    // hdPbrt: thin film (see SetFilm). Fr() is the interface reflectance for
+    // incidence cosine cosTheta_i (negative: from inside), Fresnel lerped
+    // with the film's spectral Airy reflectance by the film weight; the
+    // transmission takes 1 - Fr (the film doesn't absorb).
+    Float filmWeight = 0, filmThickness = 0, filmEta = 1.4f;
+    SampledSpectrum filmLambda;
+    PBRT_CPU_GPU bool HasFilm() const { return filmWeight > 0 && filmThickness > 0 && eta > 1; }
+    PBRT_CPU_GPU SampledSpectrum Fr(Float cosTheta_i) const {
+        const Float F = FrDielectric(cosTheta_i, eta);
+        if (!HasFilm())
+            return SampledSpectrum(F);
+        // The film is on the outside: a lossless stack reflects the same
+        // from both sides, so from inside use the matching outside angle.
+        Float cosAir = Clamp(cosTheta_i, -1, 1);
+        if (cosAir < 0) {
+            const Float sin2Air = (1 - Sqr(cosAir)) * Sqr(eta);
+            if (sin2Air >= 1)
+                return SampledSpectrum(1.f);  // total internal reflection
+            cosAir = std::sqrt(1 - sin2Air);
+        }
+        SampledSpectrum r;
+        for (int i = 0; i < NSpectrumSamples; ++i)
+            r[i] = Lerp(filmWeight, F,
+                        HdPbrtThinFilmR(cosAir, filmLambda[i], filmThickness, filmEta, eta));
+        return r;
+    }
 };
 
