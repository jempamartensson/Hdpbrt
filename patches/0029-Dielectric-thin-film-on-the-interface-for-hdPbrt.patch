+// Thin-film interference (for hdPbrt): reflectance of a film of index nFilm
+// and thickness dNm (nanometres) between air and a dielectric substrate of
+// index nSub, at wavelength lambdaNm, for incidence cosine cosTheta. Exact
+// Airy summation of the amplitude coefficients, s and p averaged (OpenPBR's
+// thin film; MaterialX/Typhoon use Belcour and Barla's RGB approximation).
+PBRT_CPU_GPU inline Float HdPbrtThinFilmR(Float cosTheta, Float lambdaNm, Float dNm,
+                                          Float nFilm, Float nSub) {
+    const Float c1 = Clamp(cosTheta, 0, 1), s1Sq = 1 - c1 * c1;
+    nFilm = std::max<Float>(nFilm, 1e-3f);
+    nSub = std::max<Float>(nSub, 1);
+    const Float s2Sq = s1Sq / Sqr(nFilm);
+    if (s2Sq >= 1)
+        return 1;  // total internal reflection at the film (film index < 1)
+    const Float c2 = SafeSqrt(1 - s2Sq), c3 = SafeSqrt(1 - s1Sq / Sqr(nSub));
+    const Float n1 = 1, n2 = nFilm, n3 = nSub;
+    const Float delta = 4 * Pi * n2 * dNm * c2 / lambdaNm;
+    const Float cosD = std::cos(delta);
+    auto airy = [&](Float r12, Float r23) {
+        Float num = r12 * r12 + r23 * r23 + 2 * r12 * r23 * cosD;
+        Float den = 1 + r12 * r12 * r23 * r23 + 2 * r12 * r23 * cosD;
+        return Clamp(num / std::max<Float>(den, 1e-8f), 0, 1);
+    };
+    const Float rs12 = (n1 * c1 - n2 * c2) / (n1 * c1 + n2 * c2);
+    const Float rs23 = (n2 * c2 - n3 * c3) / (n2 * c2 + n3 * c3);
+    const Float rp12 = (n2 * c1 - n1 * c2) / (n2 * c1 + n1 * c2);
+    const Float rp23 = (n3 * c2 - n2 * c3) / (n3 * c2 + n2 * c3);
+    return (airy(rs12, rs23) + airy(rp12, rp23)) / 2;
+}
