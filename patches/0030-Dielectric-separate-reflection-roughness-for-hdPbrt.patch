+PBRT_CPU_GPU Float HdPbrtDielectricAlbedoInside(Float cosTheta, Float alpha, Float eta) {
+    if (eta < 1)
+        eta = 1 / eta;
+    eta = Clamp(eta, 1, kAlbedoEtaMax);
+    Float fe = std::sqrt((eta - 1) / (kAlbedoEtaMax - 1)) * (kAlbedoEta - 1);
+    Float fr = Clamp(std::sqrt(std::max<Float>(alpha, 0)), 0, 1) * (kAlbedoRough - 1);
+    Float fc = Clamp(cosTheta, 0, 1) * (kAlbedoCos - 1);
+    int e0 = std::min(int(fe), kAlbedoEta - 2), r0 = std::min(int(fr), kAlbedoRough - 2),
+        c0 = std::min(int(fc), kAlbedoCos - 2);
+    Float te = fe - e0, tr = fr - r0, tc = fc - c0;
+    auto at = [&](int e, int r) {
+        return Lerp(tc, Float(hdpbrtAlbedoIn[e][r][c0]), Float(hdpbrtAlbedoIn[e][r][c0 + 1]));
+    };
+    return Lerp(te, Lerp(tr, at(e0, r0), at(e0, r0 + 1)),
+                Lerp(tr, at(e0 + 1, r0), at(e0 + 1, r0 + 1)));
+}
