+// hdPbrt: split reflection/transmission lobes (separate roughness).
+PBRT_CPU_GPU void DielectricBxDF::SplitProbs(Vector3f wo, BxDFReflTransFlags sampleFlags,
+                                             Float *pr, Float *pt) const {
+    // Macro-surface Fresnel, kept away from 0 and 1: rough lobes reach
+    // microfacets whose Fresnel differs from the macro one (e.g. rough
+    // transmission past the macro critical angle).
+    const Float F = Clamp(Fr(CosTheta(wo)).Average(), 0.05f, 0.95f);
+    *pr = (sampleFlags & BxDFReflTransFlags::Reflection) ? F : 0;
+    *pt = (sampleFlags & BxDFReflTransFlags::Transmission) ? 1 - F : 0;
+}
+
+PBRT_CPU_GPU pstd::optional<BSDFSample> DielectricBxDF::SampleSplit(
+    Vector3f wo, Float uc, Point2f u, TransportMode mode,
+    BxDFReflTransFlags sampleFlags) const {
+    Float pr, pt;
+    SplitProbs(wo, sampleFlags, &pr, &pt);
+    if (pr == 0 && pt == 0)
+        return {};
+    const Float sr = pr / (pr + pt), st = pt / (pr + pt);
+    if (uc < sr) {
+        if (rDistrib.EffectivelySmooth()) {
+            Vector3f wi(-wo.x, -wo.y, wo.z);
+            SampledSpectrum fr = Fr(CosTheta(wo)) / AbsCosTheta(wi);
+            return BSDFSample(fr, wi, sr, BxDFFlags::SpecularReflection);
+        }
+        Vector3f wm = rDistrib.Sample_wm(wo, u);
+        Vector3f wi = Reflect(wo, wm);
+        if (!SameHemisphere(wo, wi) || wi.z == 0)
+            return {};
+        Float pdf = rDistrib.PDF(wo, wm) / (4 * AbsDot(wo, wm)) * sr;
+        SampledSpectrum f = Fr(Dot(wo, wm)) *
+                            (rDistrib.D(wm) * rDistrib.G(wo, wi) /
+                             std::abs(4 * CosTheta(wi) * CosTheta(wo)) * MultiScatterScale(wo));
+        return BSDFSample(f, wi, pdf, BxDFFlags::GlossyReflection);
+    }
+    if (mfDistrib.EffectivelySmooth()) {
+        Vector3f wi;
+        Float etap;
+        if (!Refract(wo, Normal3f(0, 0, 1), eta, &etap, &wi))
+            return {};
+        SampledSpectrum ft = (SampledSpectrum(1.f) - Fr(CosTheta(wo))) / AbsCosTheta(wi);
+        ft *= tint * TopThroughput(wo);
+        if (mode == TransportMode::Radiance)
+            ft /= Sqr(etap);
+        return BSDFSample(ft, wi, st, BxDFFlags::SpecularTransmission, etap);
+    }
+    Vector3f wm = mfDistrib.Sample_wm(wo, u);
+    Float etap;
+    Vector3f wi;
+    if (!Refract(wo, (Normal3f)wm, eta, &etap, &wi) || SameHemisphere(wo, wi) || wi.z == 0)
+        return {};
+    Float denom = Sqr(Dot(wi, wm) + Dot(wo, wm) / etap);
+    Float dwm_dwi = AbsDot(wi, wm) / denom;
+    Float pdf = mfDistrib.PDF(wo, wm) * dwm_dwi * st;
+    SampledSpectrum ft = (SampledSpectrum(1.f) - Fr(Dot(wo, wm))) *
+                         (mfDistrib.D(wm) * mfDistrib.G(wo, wi) *
+                          std::abs(Dot(wi, wm) * Dot(wo, wm) /
+                                   (CosTheta(wi) * CosTheta(wo) * denom)));
+    ft *= tint * (TopThroughput(wo) * MultiScatterScale(wo));
+    if (mode == TransportMode::Radiance)
+        ft /= Sqr(etap);
+    return BSDFSample(ft, wi, pdf, BxDFFlags::GlossyTransmission, etap);
+}
+
+// Generalized half vector for (wo, wi); false if degenerate or backfacing.
+PBRT_CPU_GPU static bool HdPbrtSplitHalf(Vector3f wo, Vector3f wi, Float eta, Vector3f *wm,
+                                         Float *etap) {
+    Float cosTheta_o = CosTheta(wo), cosTheta_i = CosTheta(wi);
+    if (cosTheta_i == 0 || cosTheta_o == 0)
+        return false;
+    bool reflect = cosTheta_i * cosTheta_o > 0;
+    *etap = reflect ? 1 : (cosTheta_o > 0 ? eta : 1 / eta);
+    Vector3f m = wi * *etap + wo;
+    if (LengthSquared(m) == 0)
+        return false;
+    m = FaceForward(Normalize(m), Normal3f(0, 0, 1));
+    if (Dot(m, wi) * cosTheta_i < 0 || Dot(m, wo) * cosTheta_o < 0)
+        return false;
+    *wm = m;
+    return true;
+}
+
+PBRT_CPU_GPU SampledSpectrum DielectricBxDF::fSplit(Vector3f wo, Vector3f wi,
+                                                    TransportMode mode) const {
+    Vector3f wm;
+    Float etap;
+    if (!HdPbrtSplitHalf(wo, wi, eta, &wm, &etap))
+        return SampledSpectrum(0.f);
+    Float cosTheta_o = CosTheta(wo), cosTheta_i = CosTheta(wi);
+    if (cosTheta_i * cosTheta_o > 0) {
+        if (rDistrib.EffectivelySmooth())
+            return SampledSpectrum(0.f);
+        return Fr(Dot(wo, wm)) * (rDistrib.D(wm) * rDistrib.G(wo, wi) /
+                                  std::abs(4 * cosTheta_i * cosTheta_o) *
+                                  MultiScatterScale(wo));
+    }
+    if (mfDistrib.EffectivelySmooth())
+        return SampledSpectrum(0.f);
+    Float denom = Sqr(Dot(wi, wm) + Dot(wo, wm) / etap) * cosTheta_i * cosTheta_o;
+    SampledSpectrum ft = (SampledSpectrum(1.f) - Fr(Dot(wo, wm))) *
+                         (mfDistrib.D(wm) * mfDistrib.G(wo, wi) *
+                          std::abs(Dot(wi, wm) * Dot(wo, wm) / denom));
+    if (mode == TransportMode::Radiance)
+        ft /= Sqr(etap);
+    return tint * ft * (TopThroughput(wo) * MultiScatterScale(wo));
+}
+
+PBRT_CPU_GPU Float DielectricBxDF::PDFSplit(Vector3f wo, Vector3f wi,
+                                            BxDFReflTransFlags sampleFlags) const {
+    Vector3f wm;
+    Float etap;
+    if (!HdPbrtSplitHalf(wo, wi, eta, &wm, &etap))
+        return 0;
+    Float pr, pt;
+    SplitProbs(wo, sampleFlags, &pr, &pt);
+    if (pr == 0 && pt == 0)
+        return 0;
+    if (CosTheta(wi) * CosTheta(wo) > 0) {
+        if (rDistrib.EffectivelySmooth())
+            return 0;
+        return rDistrib.PDF(wo, wm) / (4 * AbsDot(wo, wm)) * pr / (pr + pt);
+    }
+    if (mfDistrib.EffectivelySmooth())
+        return 0;
+    Float denom = Sqr(Dot(wi, wm) + Dot(wo, wm) / etap);
+    return mfDistrib.PDF(wo, wm) * AbsDot(wi, wm) / denom * pt / (pr + pt);
+}
