diff --git a/src/pbrt/bxdfs.h b/src/pbrt/bxdfs.h
index 3038065..7f5a17a 100644
--- a/src/pbrt/bxdfs.h
+++ b/src/pbrt/bxdfs.h
@@ -26,18 +26,55 @@
 
 namespace pbrt {
 
+// Energy-preserving Oren-Nayar (EON; Portsmouth, Kutz, Hill 2024), as
+// MaterialX's oren_nayar_diffuse_bsdf with energy_compensation and Typhoon:
+// a FON single-scatter term plus a multiple-scatter term that restores the
+// energy lost to roughness. Returns f (already over pi); r = 0 is Lambert.
+// (for hdPbrt)
+PBRT_CPU_GPU inline Float HdPbrtFONAlbedo(Float mu, Float r) {
+    const Float A = 0.5f - 2 / (3 * Pi);
+    const Float m = 1 - Clamp(mu, 0, 1);
+    const Float g = m * (0.0571085289f + m * (0.491881867f + m * (-0.332181442f +
+                                                                  m * 0.0714429953f)));
+    return (1 + r * g) / (1 + A * r);
+}
+
+PBRT_CPU_GPU inline SampledSpectrum HdPbrtEON(const SampledSpectrum &rho, Float r,
+                                              Float muI, Float muO, Float dotIO) {
+    r = Clamp(r, 0, 1);
+    if (r <= 0)
+        return rho * InvPi;
+    const Float A = 0.5f - 2 / (3 * Pi), B = 2.f / 3.f - 28 / (15 * Pi);
+    const Float eps = 1e-6f;
+    muI = std::max(muI, eps);
+    muO = std::max(muO, eps);
+    const Float s = dotIO - muI * muO;
+    const Float sOverF = s > 0 ? s / std::max(muI, muO) : s;
+    const Float aF = 1 / (1 + A * r);
+    SampledSpectrum fSS = rho * (InvPi * aF * (1 + r * sOverF));
+    const Float avgEF = aF * (1 + B * r);
+    SampledSpectrum one(1.f);
+    SampledSpectrum rhoMS = rho * rho * avgEF / (one - rho * (1 - avgEF));
+    const Float fMS = InvPi * std::max(eps, 1 - HdPbrtFONAlbedo(muI, r)) *
+                      std::max(eps, 1 - HdPbrtFONAlbedo(muO, r)) /
+                      std::max(eps, 1 - avgEF);
+    return fSS + rhoMS * fMS;
+}
+
 // DiffuseBxDF Definition
 class DiffuseBxDF {
   public:
     // DiffuseBxDF Public Methods
     DiffuseBxDF() = default;
     PBRT_CPU_GPU
-    DiffuseBxDF(SampledSpectrum R) : R(R) {}
+    DiffuseBxDF(SampledSpectrum R, Float roughness = 0) : R(R), roughness(roughness) {}
 
     PBRT_CPU_GPU
     SampledSpectrum f(Vector3f wo, Vector3f wi, TransportMode mode) const {
         if (!SameHemisphere(wo, wi))
             return SampledSpectrum(0.f);
+        if (roughness > 0)
+            return HdPbrtEON(R, roughness, AbsCosTheta(wi), AbsCosTheta(wo), Dot(wo, wi));
         return R * InvPi;
     }
 
@@ -53,7 +90,7 @@ class DiffuseBxDF {
             wi.z *= -1;
         Float pdf = CosineHemispherePDF(AbsCosTheta(wi));
 
-        return BSDFSample(R * InvPi, wi, pdf, BxDFFlags::DiffuseReflection);
+        return BSDFSample(f(wo, wi, mode), wi, pdf, BxDFFlags::DiffuseReflection);
     }
 
     PBRT_CPU_GPU
@@ -79,6 +116,7 @@ class DiffuseBxDF {
 
   private:
     SampledSpectrum R;
+    Float roughness = 0;
 };
 
 // DiffuseTransmissionBxDF Definition
@@ -1208,11 +1246,13 @@ class HdPbrtLayeredBxDF {
                       HdPbrtDielectricLobe coat, SampledSpectrum coatTint,
                       Float metalWeight = 0, int metalMode = 0,
                       SampledSpectrum metalA = SampledSpectrum(0.f),
-                      SampledSpectrum metalB = SampledSpectrum(0.f), Float metalScale = 1)
+                      SampledSpectrum metalB = SampledSpectrum(0.f), Float metalScale = 1,
+                      Float diffuseRoughness = 0)
         : R(R), T(T), specTint(specTint), sheenColor(sheenColor), coatTint(coatTint),
           metalA(metalA), metalB(metalB), spec(spec), coat(coat),
           sheenWeight(sheenWeight), sheenAlpha(sheenAlpha), metalWeight(metalWeight),
-          metalScale(metalScale), metalMode(metalMode), sheenOnTop(sheenOnTop) {}
+          metalScale(metalScale), diffuseRoughness(diffuseRoughness), metalMode(metalMode),
+          sheenOnTop(sheenOnTop) {}
 
     PBRT_CPU_GPU
     BxDFFlags Flags() const {
@@ -1422,7 +1462,9 @@ class HdPbrtLayeredBxDF {
 
     PBRT_CPU_GPU
     SampledSpectrum FUpper(Vector3f wo, Vector3f wi, const Weights &k) const {
-        SampledSpectrum result = R * k.under * (k.base * InvPi);
+        SampledSpectrum result =
+            HdPbrtEON(R, diffuseRoughness, AbsCosTheta(wi), AbsCosTheta(wo), Dot(wo, wi)) *
+            k.under * k.base;
         if (AbsCosTheta(wo) == 0 || AbsCosTheta(wi) == 0)
             return result;
         Vector3f wm = wi + wo;
@@ -1481,7 +1523,7 @@ class HdPbrtLayeredBxDF {
 
     SampledSpectrum R, T, specTint, sheenColor, coatTint, metalA, metalB;
     HdPbrtDielectricLobe spec, coat;
-    Float sheenWeight, sheenAlpha, metalWeight, metalScale;
+    Float sheenWeight, sheenAlpha, metalWeight, metalScale, diffuseRoughness;
     int metalMode;
     bool sheenOnTop;
 };
