+// hdPbrt (patch 47): a hit on a prototype's emitter becomes a hit on the
+// instance's light for that emissive shape (or no emitter without one).
+static void HdPbrtInstanceEmitter(SurfaceInteraction &intr, const Light *lights) {
+    if (!intr.areaLight)
+        return;
+    const DiffuseAreaLight *dl = Light(intr.areaLight).CastOrNullptr<DiffuseAreaLight>();
+    if (!dl || dl->hdpbrtSlot < 0)
+        return;
+    intr.hdpbrtEmitterTri = dl->hdpbrtTri;
+    intr.areaLight = lights ? lights[dl->hdpbrtSlot] : Light(nullptr);
+}
