+// hdPbrt: instanced and moving mesh emitters (pbrt patch 47). An emissive
+// shape inside an object instance definition becomes one light per instance:
+// a DiffuseAreaLight in "mesh mode" that samples the prototype's triangles
+// (HdPbrtMeshEmitter, shared by all instances) through the instance's
+// transform at the reference point's time (HdPbrtLightXform).
+class DiffuseAreaLight;
+
+struct HdPbrtLightXform {
+    // Static (no segments), or keyed: segment k spans times[k]..times[k + 1].
+    Transform fixed;
+    std::vector<AnimatedTransform> segs;
+    std::vector<Float> times;
+    Transform At(Float t) const {
+        if (segs.empty())
+            return fixed;
+        size_t k = 0;
+        while (k + 1 < segs.size() && times[k + 1] <= t)
+            ++k;
+        return segs[k].Interpolate(t);
+    }
+    Bounds3f MotionBounds(const Bounds3f &b) const {
+        if (segs.empty())
+            return fixed(b);
+        Bounds3f r;
+        for (const AnimatedTransform &s : segs)
+            r = Union(r, s.MotionBounds(b));
+        return r;
+    }
+    // Area scale of a surface with unit normal n under t: |det M| |M^-T n|.
+    static Float AreaScale(const Transform &t, Normal3f n) {
+        const SquareMatrix<4> &m = t.GetMatrix();
+        SquareMatrix<3> m3(m[0][0], m[0][1], m[0][2], m[1][0], m[1][1], m[1][2], m[2][0],
+                           m[2][1], m[2][2]);
+        return std::abs(Determinant(m3)) * Length(Vector3f(t(n)));
+    }
+};
+
+struct HdPbrtMeshEmitter {
+    // Per triangle (prototype space): its own light (emission parameters,
+    // shape), area, unit geometric normal and bounds power.
+    std::vector<const DiffuseAreaLight *> lights;
+    std::vector<Float> area, phi;
+    std::vector<Normal3f> normal;
+    AliasTable alias{Allocator()};  // by power
+    Bounds3f bounds;
+    DirectionCone cone;
+    bool twoSided = false;
+};
+
 // DiffuseAreaLight Definition
 class DiffuseAreaLight : public LightBase {
   public:
@@ -547,6 +598,9 @@ class DiffuseAreaLight : public LightBase {
