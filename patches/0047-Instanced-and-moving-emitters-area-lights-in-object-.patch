+    // slot (which emissive shape of the instance definition) and triangle
+    // index; instances replace it on hits by their own light for the slot.
+    int hdpbrtSlot = -1, hdpbrtTri = -1;
+    const Shape &HdPbrtShape() const { return shape; }
+    bool HdPbrtTwoSided() const { return twoSided; }
+    // Mesh mode (an instance's light for one emissive shape).
+    const HdPbrtMeshEmitter *hdpbrtMesh = nullptr;
+    const HdPbrtLightXform *hdpbrtXform = nullptr;
+    void SetHdPbrtMesh(const HdPbrtMeshEmitter *mesh, const HdPbrtLightXform *xform) {
+        hdpbrtMesh = mesh;
+        hdpbrtXform = xform;
+        hdpbrtSlot = hdpbrtTri = -1;
+    }
+    // Mesh mode: the solid-angle pdf of reaching triangle hit.hdpbrtEmitterTri
+    // at the hit point from ctx (the light's own PDF_Li can't tell which
+    // triangle a direction hits).
+    PBRT_CPU_GPU
+    Float HdPbrtMeshPDF(const LightSampleContext &ctx, Vector3f wi,
+                        const SurfaceInteraction &hit) const;
+
     PBRT_CPU_GPU
     pstd::optional<LightLiSample> SampleLi(LightSampleContext ctx, Point2f u,
                                            SampledWavelengths lambda,
@@ -944,6 +1019,17 @@ PBRT_CPU_GPU inline SampledSpectrum Light::L(Point3f p, Normal3f n, Point2f uv,
     return Dispatch(l);
 }
 
+// hdPbrt: the light pdf of a BSDF-sampled ray that hit emitter `light` at
+// `hit` (MIS). Mesh emitters (instanced / moving, patch 47) need the hit's
+// triangle; every other light uses PDF_Li.
+PBRT_CPU_GPU inline Float HdPbrtAreaPDF(Light light, const LightSampleContext &ctx,
+                                        Vector3f wi, const SurfaceInteraction &hit) {
+    if (const DiffuseAreaLight *dl = light.CastOrNullptr<DiffuseAreaLight>();
+        dl && dl->hdpbrtMesh)
+        return dl->HdPbrtMeshPDF(ctx, wi, hit);
+    return light.PDF_Li(ctx, wi, true);
+}
