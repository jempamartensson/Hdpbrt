+PBRT_CPU_GPU Float DiffuseAreaLight::HdPbrtMeshPDF(const LightSampleContext &ctx, Vector3f wi,
+                                                   const SurfaceInteraction &hit) const {
+    const int k = hit.hdpbrtEmitterTri;
+    if (!hdpbrtMesh || k < 0 || k >= int(hdpbrtMesh->area.size()))
+        return 0;
+    const Transform t = hdpbrtXform->At(hit.time);
+    const Float s = HdPbrtLightXform::AreaScale(t, hdpbrtMesh->normal[k]);
+    const Float d2 = DistanceSquared(ctx.p(), hit.p());
+    const Float cosL = AbsDot(hit.n, wi);
+    if (s == 0 || cosL == 0)
+        return 0;
+    return hdpbrtMesh->alias.PMF(k) / (hdpbrtMesh->area[k] * s) * d2 / cosL;
+}
