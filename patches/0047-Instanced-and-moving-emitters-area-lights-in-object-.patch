+        // hdPbrt: mesh mode: every triangle has the same emission parameters.
+        if (hdpbrtMesh)
+            return hdpbrtMesh->lights[0]->L(p, n, uv, w, lambda, pv);
         // Check for zero emitted radiance from point on area light
         if (!twoSided && Dot(n, w) < 0)
             return SampledSpectrum(0.f);
@@ -592,6 +646,27 @@ class DiffuseAreaLight : public LightBase {
     SpectrumTexture hdpbrtLTex;
