+// hdPbrt: "string colorspace" names the RGB primaries of a light's image,
+// overriding the file's metadata (which defaults to sRGB primaries).
+static void HdPbrtImageColorSpace(const ParameterDictionary &parameters,
+                                  const FileLoc *loc, ImageMetadata *metadata) {
+    std::string cs = parameters.GetOneString("colorspace", "");
+    if (cs.empty())
+        return;
+    const RGBColorSpace *colorSpace = RGBColorSpace::GetNamed(cs);
+    if (!colorSpace)
