@@ -0,0 +1,55 @@
+// hdPbrt: per-vertex primvars on triangle meshes, read by "hdpbrtprimvar"
+// textures at the hit point (barycentric interpolation).
+
+#ifndef PBRT_UTIL_HDPBRTPRIMVAR_H
+#define PBRT_UTIL_HDPBRTPRIMVAR_H
+
+#include <pbrt/pbrt.h>
+
+#include <string>
+
+namespace pbrt {
+
+// One primvar of a mesh: `width` floats per vertex. `id` comes from
+// HdPbrtPrimvarId (names are interned so lookups compare integers).
+struct HdPbrtMeshPrimvar {
+    int id = -1;
+    int width = 0;
+    const Float *data = nullptr;
+};
+
+// The id of a primvar name (thread-safe; the same name gives the same id).
+int HdPbrtPrimvarId(const std::string &name);
+
+// What a surface hit carries for primvar lookups.
+struct HdPbrtPrimvarHit {
+    const HdPbrtMeshPrimvar *primvars = nullptr;
+    int count = 0;
+    int v[3] = {0, 0, 0};
+    Float b[3] = {0, 0, 0};
+
+    // The interpolated value of primvar `id` (up to `width` components into
+    // `out`; missing ones keep their value). False when the mesh lacks it.
+    PBRT_CPU_GPU
+    bool Lookup(int id, int width, Float *out) const {
+        for (int i = 0; i < count; ++i) {
+            const HdPbrtMeshPrimvar &pv = primvars[i];
+            if (pv.id != id)
+                continue;
+            const int w = width < pv.width ? width : pv.width;
+            for (int k = 0; k < w; ++k)
+                out[k] = b[0] * pv.data[size_t(v[0]) * pv.width + k] +
+                         b[1] * pv.data[size_t(v[1]) * pv.width + k] +
+                         b[2] * pv.data[size_t(v[2]) * pv.width + k];
+            // A one-component primvar read as a color: grey.
+            for (int k = w; k < width && pv.width == 1; ++k)
+                out[k] = out[0];
+            return true;
+        }
+        return false;
+    }
+};
+
+}  // namespace pbrt
+
+#endif  // PBRT_UTIL_HDPBRTPRIMVAR_H
