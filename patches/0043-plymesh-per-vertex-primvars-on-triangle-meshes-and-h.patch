+// hdPbrt: a mesh primvar at the hit point (per-vertex values interpolated
+// barycentrically; pbrt plymesh "hdpbrtprimvars"). Shapes without it give
+// "default". Float: one component ("integer component"); spectrum: the first
+// three as RGB in the texture's color space.
+class FloatHdPbrtPrimvarTexture {
+  public:
+    FloatHdPbrtPrimvarTexture(int id, int component, Float def, Float scale, Float power)
+        : id(id), component(component), def(def), scale(scale), power(power) {}
+    PBRT_CPU_GPU
+    Float Evaluate(TextureEvalContext ctx) const {
+        Float v[4] = {def, def, def, def};
+        Float x = ctx.hdpbrtPrimvars.Lookup(id, component + 1, v) ? scale * v[component] : def;
+        // "float power": e.g. 2 for MaterialX roughness -> GGX alpha.
+        return power == 1 ? x : std::pow(std::max<Float>(x, 0), power);
+    }
+    static FloatHdPbrtPrimvarTexture *Create(const Transform &renderFromTexture,
+                                             const TextureParameterDictionary &parameters,
+                                             const FileLoc *loc, Allocator alloc);
+    std::string ToString() const;
+
+  private:
+    int id, component;
+    Float def, scale, power;
+};
+
+class SpectrumHdPbrtPrimvarTexture {
+  public:
+    SpectrumHdPbrtPrimvarTexture(int id, RGB def, Float scale, const RGBColorSpace *cs,
+                                 SpectrumType spectrumType)
+        : id(id), def(def), scale(scale), cs(cs), spectrumType(spectrumType) {}
+    PBRT_CPU_GPU
+    SampledSpectrum Evaluate(TextureEvalContext ctx, SampledWavelengths lambda) const {
+        Float v[3] = {def.r, def.g, def.b};
+        RGB rgb = def;
+        if (ctx.hdpbrtPrimvars.Lookup(id, 3, v))
+            rgb = RGB(v[0], v[1], v[2]) * scale;
+        rgb = ClampZero(rgb);
+        if (spectrumType == SpectrumType::Unbounded)
+            return RGBUnboundedSpectrum(*cs, rgb).Sample(lambda);
+        else if (spectrumType == SpectrumType::Albedo)
+            return RGBAlbedoSpectrum(*cs, Clamp(rgb, 0, 1)).Sample(lambda);
+        return RGBIlluminantSpectrum(*cs, rgb).Sample(lambda);
+    }
+    static SpectrumHdPbrtPrimvarTexture *Create(const Transform &renderFromTexture,
+                                                const TextureParameterDictionary &parameters,
+                                                SpectrumType spectrumType, const FileLoc *loc,
+                                                Allocator alloc);
+    std::string ToString() const;
+
+  private:
+    int id;
+    RGB def;
+    Float scale;
+    const RGBColorSpace *cs;
+    SpectrumType spectrumType;
+};
