+void HdPbrtGraph::BindPrimvars(const std::vector<std::string> &attrNames,
+                               const std::vector<int> &attrWidths) {
+    for (size_t s = 0; s < pvNames.size(); ++s) {
+        pvAttr[s] = -1;
+        for (size_t a = 0; a < attrNames.size(); ++a)
+            if (attrNames[a] == pvNames[s] && attrWidths[a] >= 1) {
+                pvAttr[s] = int(a);
+                break;
+            }
+    }
+}
+
 HdPbrtGraph::V4 HdPbrtGraph::Evaluate(const Vertex &vx) const {
     thread_local std::vector<V4> R;
     R = init;
@@ -699,6 +719,26 @@ HdPbrtGraph::V4 HdPbrtGraph::Evaluate(const Vertex &vx) const {
         case OpCopy:
             r = reg(a[0]);
             break;
+        case OpPv: {  // slot, default
+            const int slot = a[0], at = pvAttr[slot];
+            if (at < 0 || !vx.attr || at >= int(vx.attr->size())) {
+                r = reg(a[1]);
+                break;
+            }
+            const std::vector<Float> &d = (*vx.attr)[at];
+            const int w = pvWidths[slot];
+            const size_t base = size_t(vx.index) * w;
+            if (base + w > d.size()) {
+                r = reg(a[1]);
+                break;
+            }
+            if (w == 1)
+                r = Broadcast(d[base]);
+            else
+                for (int k = 0; k < w; ++k)
+                    r[k] = d[base + k];
+            break;
+        }
         }
         if (in.dst < nr)
             R[in.dst] = r;
