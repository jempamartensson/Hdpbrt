@@ -31,6 +31,21 @@
 
 namespace pbrt {
 
+// hdPbrt: "integer hdpbrtlinks" [collection indices 0..63] -> membership mask
+// for light linking. Without the parameter a shape is in every collection;
+// an empty membership is written as "integer hdpbrtlinks" [-1].
+static uint64_t HdPbrtLinkMask(const ParameterDictionary &parameters) {
+    std::vector<int> links = parameters.GetIntArray("hdpbrtlinks");
+    if (links.empty())
+        return ~uint64_t(0);
+    uint64_t m = 0;
+    for (int l : links)
+        if (l >= 0 && l < 64)
+            m |= uint64_t(1) << l;
+    return m;
+}
