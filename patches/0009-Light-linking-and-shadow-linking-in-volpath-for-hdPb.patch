 // VolPathIntegrator Method Definitions
+// hdPbrt: light linking. Whether a light illuminates a surface with the given
+// collection mask, and whether a surface blocks the light.
+static bool HdPbrtLit(const Light &light, uint64_t mask) {
+    auto get = [](auto ptr) { return ptr->hdpbrtLightLink; };
+    const int link = light.DispatchCPU(get);
+    return link < 0 || ((mask >> link) & 1);
+}
+static bool HdPbrtBlocks(const Light &light, uint64_t mask) {
+    auto get = [](auto ptr) { return ptr->hdpbrtShadowLink; };
+    const int link = light.DispatchCPU(get);
+    return link < 0 || ((mask >> link) & 1);
+}
