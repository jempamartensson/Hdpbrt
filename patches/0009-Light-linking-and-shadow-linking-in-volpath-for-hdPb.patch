+// hdPbrt: read the light-linking parameters into whichever light this is
+// (const dispatch: pbrt's non-const one doesn't take nine light types).
+static void HdPbrtReadLinks(const Light &light, const ParameterDictionary &parameters) {
+    // A named lambda: pbrt's dispatch over more than 8 types forwards it as an
+    // lvalue.
+    auto read = [&](auto ptr) {
+        using T = std::remove_const_t<std::remove_pointer_t<decltype(ptr)>>;
+        const_cast<T *>(ptr)->HdPbrtReadLinks(parameters);
+        return 0;
+    };
+    light.DispatchCPU(read);
+}
