-            p.trans = std::max<Float>(k.base * under * T.Average(), 1e-3f);
+            p.trans = std::max<Float>(k.base * under * k.film.Average() * T.Average(), 1e-3f);
         p.sum = p.coat + p.spec + p.metal + p.cos + p.trans;
         if (p.sum > 0) {
             p.coat /= p.sum;
@@ -1478,14 +1555,16 @@ class HdPbrtLayeredBxDF {
     SampledSpectrum FUpper(Vector3f wo, Vector3f wi, const Weights &k) const {
         SampledSpectrum result =
             HdPbrtEON(R, diffuseRoughness, AbsCosTheta(wi), AbsCosTheta(wo), Dot(wo, wi)) *
-            k.under * k.base;
