-                    k.spec * under * spec.weight * spec.Albedo(wo) * specTint.Average(), 1e-3f);
+                    k.spec * under * spec.weight *
+                        (HasFilm() ? SpecFresnel(wo.z).Average() : spec.Albedo(wo)) *
+                        specTint.Average(),
+                    1e-3f);
             if (HasMetal())
