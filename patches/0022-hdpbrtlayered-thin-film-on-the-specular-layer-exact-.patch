     struct Probs {
@@ -1410,7 +1460,25 @@ class HdPbrtLayeredBxDF {
     };
 
     PBRT_CPU_GPU
-    bool HasSpec() const { return spec.Active() && bool(specTint); }
+    bool HasSpec() const { return SpecOn() && bool(specTint); }
+    PBRT_CPU_GPU
+    bool HasFilm() const { return filmWeight > 0 && filmThickness > 0; }
+    // The specular layer reflects: Fresnel (eta != 1) or a thin film on it.
+    PBRT_CPU_GPU
+    bool SpecOn() const { return spec.weight > 0 && (spec.eta != 1 || HasFilm()); }
+    // Specular Fresnel, with the thin film mixed in by its weight.
+    PBRT_CPU_GPU
+    SampledSpectrum SpecFresnel(Float cosTheta) const {
+        Float F = FrDielectric(cosTheta, spec.eta);
+        if (!HasFilm())
+            return SampledSpectrum(F);
+        SampledSpectrum r;
+        for (int i = 0; i < NSpectrumSamples; ++i)
