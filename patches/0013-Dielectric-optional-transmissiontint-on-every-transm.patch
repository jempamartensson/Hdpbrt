From 73d85e8747b30db4979b7de9124bafe62c0a8014 Mon Sep 17 00:00:00 2001
From: jempa <jempamartensson@gmail.com>
Date: Mon, 23 Nov 2026 07:02:17 +0100
Subject: [PATCH 13/43] Dielectric: optional "transmissiontint" on every
 transmission event (for hdPbrt)

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 src/pbrt/bxdfs.cpp     |  4 +++-
 src/pbrt/bxdfs.h       |  7 +++++--
 src/pbrt/materials.cpp |  4 +++-
 src/pbrt/materials.h   | 14 ++++++++++----
 4 files changed, 21 insertions(+), 8 deletions(-)

diff --git a/src/pbrt/bxdfs.cpp b/src/pbrt/bxdfs.cpp
index 8a629ad..27ea4d5 100644
--- a/src/pbrt/bxdfs.cpp
+++ b/src/pbrt/bxdfs.cpp
@@ -108,6 +108,7 @@ PBRT_CPU_GPU pstd::optional<BSDFSample> DielectricBxDF::Sample_f(
                 return {};
 
             SampledSpectrum ft(T / AbsCosTheta(wi));
+            ft *= tint;
             // Account for non-symmetry with transmission to different medium
             if (mode == TransportMode::Radiance)
                 ft /= Sqr(etap);
@@ -162,6 +163,7 @@ PBRT_CPU_GPU pstd::optional<BSDFSample> DielectricBxDF::Sample_f(
             SampledSpectrum ft(T * mfDistrib.D(wm) * mfDistrib.G(wo, wi) *
                                std::abs(Dot(wi, wm) * Dot(wo, wm) /
                                         (CosTheta(wi) * CosTheta(wo) * denom)));
+            ft *= tint;
             // Account for non-symmetry with transmission to different medium
             if (mode == TransportMode::Radiance)
                 ft /= Sqr(etap);
@@ -206,7 +208,7 @@ PBRT_CPU_GPU SampledSpectrum DielectricBxDF::f(Vector3f wo, Vector3f wi, Transpo
         if (mode == TransportMode::Radiance)
             ft /= Sqr(etap);
 
-        return SampledSpectrum(ft);
+        return tint * ft;
     }
 }
 
diff --git a/src/pbrt/bxdfs.h b/src/pbrt/bxdfs.h
index 181c738..92433b9 100644
--- a/src/pbrt/bxdfs.h
+++ b/src/pbrt/bxdfs.h
@@ -169,8 +169,9 @@ class DielectricBxDF {
     // DielectricBxDF Public Methods
     DielectricBxDF() = default;
     PBRT_CPU_GPU
-    DielectricBxDF(Float eta, TrowbridgeReitzDistribution mfDistrib)
-        : eta(eta), mfDistrib(mfDistrib) {}
+    DielectricBxDF(Float eta, TrowbridgeReitzDistribution mfDistrib,
+                   SampledSpectrum tint = SampledSpectrum(1.f))
+        : eta(eta), mfDistrib(mfDistrib), tint(tint) {}
 
     PBRT_CPU_GPU
     BxDFFlags Flags() const {
@@ -203,6 +204,8 @@ class DielectricBxDF {
     // DielectricBxDF Private Members
     Float eta;
     TrowbridgeReitzDistribution mfDistrib;
+    // hdPbrt: multiplies every transmission event (MaterialX dielectric tint).
+    SampledSpectrum tint;
 };
 
 // ThinDielectricBxDF Definition
diff --git a/src/pbrt/materials.cpp b/src/pbrt/materials.cpp
index 095bb83..341cc9f 100644
--- a/src/pbrt/materials.cpp
+++ b/src/pbrt/materials.cpp
@@ -69,8 +69,10 @@ DielectricMaterial *DielectricMaterial::Create(
     FloatTexture displacement = parameters.GetFloatTextureOrNull("displacement", alloc);
     bool remapRoughness = parameters.GetOneBool("remaproughness", true);
 
+    SpectrumTexture tint =
+        parameters.GetSpectrumTextureOrNull("transmissiontint", SpectrumType::Albedo, alloc);
     return alloc.new_object<DielectricMaterial>(uRoughness, vRoughness, eta, displacement,
-                                                normalMap, remapRoughness);
+                                                normalMap, remapRoughness, tint);
 }
 
 // ThinDielectricMaterial Method Definitions
diff --git a/src/pbrt/materials.h b/src/pbrt/materials.h
index 300291b..cd4412a 100644
--- a/src/pbrt/materials.h
+++ b/src/pbrt/materials.h
@@ -146,8 +146,10 @@ class DielectricMaterial {
 
     // DielectricMaterial Public Methods
     DielectricMaterial(FloatTexture uRoughness, FloatTexture vRoughness, Spectrum eta,
-                       FloatTexture displacement, Image *normalMap, bool remapRoughness)
-        : normalMap(normalMap),
+                       FloatTexture displacement, Image *normalMap, bool remapRoughness,
+                       SpectrumTexture tint = nullptr)
+        : tint(tint),
+          normalMap(normalMap),
           displacement(displacement),
           uRoughness(uRoughness),
           vRoughness(vRoughness),
@@ -158,7 +160,7 @@ class DielectricMaterial {
 
     template <typename TextureEvaluator>
     PBRT_CPU_GPU bool CanEvaluateTextures(TextureEvaluator texEval) const {
-        return texEval.CanEvaluate({uRoughness, vRoughness}, {});
+        return texEval.CanEvaluate({uRoughness, vRoughness}, {tint});
     }
 
     PBRT_CPU_GPU
@@ -199,11 +201,15 @@ class DielectricMaterial {
         TrowbridgeReitzDistribution distrib(urough, vrough);
 
         // Return BSDF for dielectric material
-        return DielectricBxDF(sampledEta, distrib);
+        SampledSpectrum t(1.f);
+        if (tint)
+            t = Clamp(texEval(tint, ctx, lambda), 0, 1);
+        return DielectricBxDF(sampledEta, distrib, t);
     }
 
   private:
     // DielectricMaterial Private Members
+    SpectrumTexture tint;  // hdPbrt: "transmissiontint"
     Image *normalMap;
     FloatTexture displacement;
     FloatTexture uRoughness, vRoughness;
-- 
2.43.0

