diff --git a/src/pbrt/scene.cpp b/src/pbrt/scene.cpp
index 545c3ef..5561d6c 100644
--- a/src/pbrt/scene.cpp
+++ b/src/pbrt/scene.cpp
@@ -447,6 +447,44 @@ void BasicSceneBuilder::ObjectInstance(const std::string &origName, FileLoc loc)
             p->lookedUp = true;
         }
 
+    // hdPbrt: per-instance primvars (patch 48).
+    std::vector<std::string> hdpbrtPvNames;
+    std::vector<int> hdpbrtPvWidths;
+    std::vector<Float> hdpbrtPvValues;
+    {
+        const ParsedParameter *names = nullptr, *values = nullptr;
+        for (const ParsedParameter *p : graphicsState.shapeAttributes) {
+            if (p->name == "hdpbrtinstanceprimvars" && p->type == "string")
+                names = p;
+            else if (p->name == "hdpbrtinstanceprimvarvalues" && p->type == "float")
+                values = p;
+        }
+        if (names && values) {
+            names->lookedUp = values->lookedUp = true;
+            size_t need = 0;
+            for (size_t i = 0; i + 1 < names->strings.size(); i += 2) {
+                const int w = std::max(1, std::atoi(names->strings[i + 1].c_str()));
+                hdpbrtPvNames.push_back(names->strings[i]);
+                hdpbrtPvWidths.push_back(w);
+                need += w;
+            }
+            if (values->floats.size() < need) {
+                Warning(&loc, "hdpbrtinstanceprimvarvalues: need %d values; ignored.",
+                        int(need));
+                hdpbrtPvNames.clear();
+                hdpbrtPvWidths.clear();
+            } else
+                hdpbrtPvValues.assign(values->floats.begin(), values->floats.begin() + need);
+        }
+    }
+    auto hdpbrtTag = [&](InstanceSceneEntity &e) {
+        e.hdpbrtInstanceId = hdpbrtInstanceId;
+        e.hdpbrtInstanceLinks = hdpbrtInstanceLinks;
+        e.hdpbrtPvNames = hdpbrtPvNames;
+        e.hdpbrtPvWidths = hdpbrtPvWidths;
+        e.hdpbrtPvValues = hdpbrtPvValues;
+    };
+
     // hdPbrt: N transform keys, Attribute "shape" "float hdpbrtmotionxforms"
     // [16 * N] (world from instance, like Transform) "float hdpbrtmotiontimes" [N].
     {
