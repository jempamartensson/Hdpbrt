+// hdPbrt: HdPbrtShaping Definition
+// USD light shaping (UsdLuxShapingAPI) as a multiplier on a light's emission:
+// focus and focus tint, cone angle and softness, and an IES profile given as a
+// one-channel table image (u = phi / 2pi, v = theta / pi, theta measured from
+// the light's axis). The light's axis is -z in light space. Parameters:
+// "float shapingfocus", "rgb shapingfocustint", "float shapingconeangle"
+// (degrees, 180 = no cone), "float shapingconesoftness", "string shapingies".
+struct HdPbrtShaping {
+    static HdPbrtShaping Create(const ParameterDictionary &parameters,
+                                const RGBColorSpace *colorSpace, const FileLoc *loc,
+                                Allocator alloc);
+
+    // wLight: emission direction (away from the light) in light space.
+    PBRT_CPU_GPU
+    SampledSpectrum Eval(Vector3f wLight, const SampledWavelengths &lambda) const {
+        SampledSpectrum f(1.f);
+        if (!active)
+            return f;
+        const Vector3f e = Normalize(wLight);
+        const Float cosOff = -e.z;
+        if (focus > 0) {
+            // lerp(|cos|^focus, focusTint, white)
+            const Float ff = std::pow(std::abs(cosOff), focus);
+            if (focusTint)
+                f = focusTint->Sample(lambda) * (1 - ff) + SampledSpectrum(ff);
+            else
+                f = SampledSpectrum(ff);
+        }
+        const Float theta = SafeACos(cosOff);
+        if (coneCutoff < Pi) {
+            Float s;
+            if (coneSmoothStart >= coneCutoff)
+                s = theta <= coneCutoff ? 0 : 1;
+            else
+                s = SmoothStep(theta, coneSmoothStart, coneCutoff);
+            f *= 1 - s;
+        }
+        if (ies) {
+            // Direction toward the light, as USD's reference (hdEmbree) does.
+            Float phi = std::atan2(-e.y, -e.x);
+            if (phi < 0)
+                phi += 2 * Pi;
+            const Float v = ies.BilerpChannel(Point2f(phi / (2 * Pi), theta / Pi), 0,
+                                              WrapMode2D(WrapMode::Repeat, WrapMode::Clamp));
+            f *= std::max<Float>(v, 0);
+        }
+        return f;
+    }
+
+    bool active = false;
+    Float focus = 0;
+    const RGBUnboundedSpectrum *focusTint = nullptr;  // null: black
+    Float coneCutoff = Pi, coneSmoothStart = Pi;    // radians
+    Image ies;
+};
+
 // PointLight Definition
 class PointLight : public LightBase {
   public:
@@ -224,6 +280,8 @@ class PointLight : public LightBase {
         Point3f p = renderFromLight(Point3f(0, 0, 0));
         Vector3f wi = Normalize(p - ctx.p());
         SampledSpectrum Li = scale * I->Sample(lambda) / DistanceSquared(p, ctx.p());
+        if (shaping.active)  // hdPbrt
+            Li *= shaping.Eval(renderFromLight.ApplyInverse(-wi), lambda);
         return LightLiSample(Li, wi, 1, Interaction(p, &mediumInterface));
     }
 
@@ -232,6 +290,8 @@ class PointLight : public LightBase {
         return 0;
     }
 
+    HdPbrtShaping shaping;  // hdPbrt
+
   private:
     // PointLight Private Members
     const DenselySampledSpectrum *I;
@@ -446,6 +506,7 @@ class DiffuseAreaLight : public LightBase {
         if (AlphaMasked(Interaction(p, uv)))
             return SampledSpectrum(0.f);
 
+        SampledSpectrum Le;
         if (image) {
             // Return _DiffuseAreaLight_ emission using image
             RGB rgb;
@@ -453,12 +514,18 @@ class DiffuseAreaLight : public LightBase {
             for (int c = 0; c < 3; ++c)
                 rgb[c] = image.BilerpChannel(uv, c);
             RGBIlluminantSpectrum spec(*imageColorSpace, ClampZero(rgb));
-            return scale * spec.Sample(lambda);
+            Le = scale * spec.Sample(lambda);
 
         } else
-            return scale * Lemit->Sample(lambda);
+            Le = scale * Lemit->Sample(lambda);
+        // hdPbrt: USD light shaping, by the emission direction in light space.
+        if (shaping.active)
+            Le *= shaping.Eval(renderFromLight.ApplyInverse(w), lambda);
+        return Le;
     }
 
+    HdPbrtShaping shaping;  // hdPbrt
+
     PBRT_CPU_GPU
     pstd::optional<LightLiSample> SampleLi(LightSampleContext ctx, Point2f u,
                                            SampledWavelengths lambda,
