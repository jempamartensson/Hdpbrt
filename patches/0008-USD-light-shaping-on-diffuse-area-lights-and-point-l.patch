From: jempa <jempamartensson@gmail.com>
Date: Sun, 22 Nov 2026 19:30:21 +0100
Subject: [PATCH 8/8] USD light shaping on diffuse area lights and point lights
 (for hdPbrt)

"float shapingfocus", "rgb shapingfocustint", "float shapingconeangle",
"float shapingconesoftness" and "string shapingies" (a one-channel theta x phi table
image) multiply the emission by UsdLuxShapingAPI's shaping factor, evaluated in the
light's frame with -z as the axis.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 src/pbrt/lights.cpp | 41 ++++++++++++++++++++++++--
 src/pbrt/lights.h   | 71 +++++++++++++++++++++++++++++++++++++++++++--
 2 files changed, 108 insertions(+), 4 deletions(-)

diff --git a/src/pbrt/lights.cpp b/src/pbrt/lights.cpp
index 7df3178..bb2f444 100644
--- a/src/pbrt/lights.cpp
+++ b/src/pbrt/lights.cpp
@@ -209,7 +209,42 @@ PointLight *PointLight::Create(const Transform &renderFromLight, Medium medium,
     Transform tf = Translate(Vector3f(from.x, from.y, from.z));
     Transform finalRenderFromLight(renderFromLight * tf);
 
-    return alloc.new_object<PointLight>(finalRenderFromLight, medium, I, sc);
+    PointLight *light = alloc.new_object<PointLight>(finalRenderFromLight, medium, I, sc);
+    light->shaping = HdPbrtShaping::Create(parameters, colorSpace, loc, alloc);  // hdPbrt
+    return light;
+}
+
+// hdPbrt: HdPbrtShaping Method Definitions
+HdPbrtShaping HdPbrtShaping::Create(const ParameterDictionary &parameters,
+                                    const RGBColorSpace *colorSpace, const FileLoc *loc,
+                                    Allocator alloc) {
+    HdPbrtShaping s;
+    s.focus = std::max<Float>(0, parameters.GetOneFloat("shapingfocus", 0));
+    RGB tintRGB(0, 0, 0);
+    std::vector<RGB> rgbs = parameters.GetRGBArray("shapingfocustint");
+    if (!rgbs.empty())
+        tintRGB = rgbs[0];
+    if (s.focus > 0 && (tintRGB.r > 0 || tintRGB.g > 0 || tintRGB.b > 0))
+        s.focusTint = alloc.new_object<RGBUnboundedSpectrum>(*colorSpace, ClampZero(tintRGB));
+    const Float angle = parameters.GetOneFloat("shapingconeangle", 180);
+    const Float softness = Clamp(parameters.GetOneFloat("shapingconesoftness", 0), 0, 1);
+    if (angle < 180) {
+        s.coneCutoff = Radians(std::max<Float>(angle, 0));
+        s.coneSmoothStart = Lerp(softness, s.coneCutoff, Float(0));
+    }
+    std::string ies = ResolveFilename(parameters.GetOneString("shapingies", ""));
+    if (!ies.empty()) {
+        ImageAndMetadata im = Image::Read(ies, alloc);
+        if (im.image.NChannels() < 1)
+            Warning(loc, "%s: can't read the IES table; ignored.", ies);
+        else
+            s.ies = im.image.SelectChannels(im.image.AllChannelsDesc().size() == 1
+                                                ? im.image.AllChannelsDesc()
+                                                : im.image.GetChannelDesc({"R"}),
+                                            alloc);
+    }
+    s.active = s.focus > 0 || s.coneCutoff < Pi || bool(s.ies);
+    return s;
 }
 
 // DistantLight Method Definitions
@@ -936,9 +971,11 @@ DiffuseAreaLight *DiffuseAreaLight::Create(const Transform &renderFromLight,
         scale *= phi_v / k_e;
     }
 
-    return alloc.new_object<DiffuseAreaLight>(renderFromLight, medium, L, scale, shape,
+    DiffuseAreaLight *light = alloc.new_object<DiffuseAreaLight>(renderFromLight, medium, L, scale, shape,
                                               alphaTex, std::move(image), imageColorSpace,
                                               twoSided);
+    light->shaping = HdPbrtShaping::Create(parameters, colorSpace, loc, alloc);  // hdPbrt
+    return light;
 }
 
