+                bs = BSDFSample(f, wi, pLobe, BxDFFlags::SpecularReflection);
             } else {
-                Vector3f wm = mfDistrib.Sample_wm(wo, u);
+                Vector3f wm = lobe->distrib.Sample_wm(wo, u);
                 Vector3f wi = Reflect(wo, wm);
