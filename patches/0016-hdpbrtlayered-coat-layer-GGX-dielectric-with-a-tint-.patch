-          specWeight(specWeight), eta(eta), sheenWeight(sheenWeight),
-          sheenAlpha(sheenAlpha), sheenOnTop(sheenOnTop), mfDistrib(mfDistrib) {}
+                      HdPbrtDielectricLobe spec, SampledSpectrum sheenColor,
+                      Float sheenWeight, Float sheenAlpha, bool sheenOnTop,
+                      HdPbrtDielectricLobe coat, SampledSpectrum coatTint)
+        : R(R), T(T), specTint(specTint), sheenColor(sheenColor), coatTint(coatTint),
+          spec(spec), coat(coat), sheenWeight(sheenWeight), sheenAlpha(sheenAlpha),
+          sheenOnTop(sheenOnTop) {}
 
     PBRT_CPU_GPU
     BxDFFlags Flags() const {
         BxDFFlags flags = (R || HasSheen()) ? BxDFFlags::DiffuseReflection : BxDFFlags::Unset;
-        if (HasSpec())
-            flags = flags | (mfDistrib.EffectivelySmooth() ? BxDFFlags::SpecularReflection
-                                                           : BxDFFlags::GlossyReflection);
+        for (const HdPbrtDielectricLobe *l : {&spec, &coat})
+            if (l->Active())
+                flags = flags | (l->Smooth() ? BxDFFlags::SpecularReflection
+                                             : BxDFFlags::GlossyReflection);
         if (T)
             flags = flags | BxDFFlags::SpecularTransmission;
         return flags;
@@ -1193,8 +1226,7 @@ class HdPbrtLayeredBxDF {
             wo = -wo;
             wi = -wi;
