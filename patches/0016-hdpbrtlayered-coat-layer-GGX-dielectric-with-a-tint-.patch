-    }
-
     PBRT_CPU_GPU
     Weights LayerWeights(Vector3f wo) const {
-        Float tSpec = (specWeight > 0 && eta != 1)
-                          ? Clamp(1 - specWeight * SpecAlbedo(wo), 0, 1) : Float(1);
+        Float tSpec = spec.Throughput(wo), tCoat = coat.Throughput(wo);
         Float tSheen = sheenWeight > 0
                            ? Clamp(1 - sheenWeight * HdPbrtSheenAlbedo(wo.z, sheenAlpha), 0, 1)
                            : Float(1);
         Weights k;
+        k.under = coat.Active() ? coatTint : SampledSpectrum(1.f);
         if (sheenOnTop) {
             k.sheen = 1;
-            k.spec = tSheen;
