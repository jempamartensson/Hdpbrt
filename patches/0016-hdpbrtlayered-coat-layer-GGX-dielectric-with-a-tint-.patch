@@ -1152,10 +1152,42 @@ PBRT_CPU_GPU inline Float HdPbrtAshikhminV(Float cosO, Float cosI) {
     return 1 / (4 * (cosI + cosO - cosI * cosO) + 1e-6f);
 }
 
+// HdPbrtDielectricLobe: a weighted GGX dielectric reflection lobe (a coat or
+// a specular layer), used by HdPbrtLayeredBxDF.
+struct HdPbrtDielectricLobe {
+    Float weight = 0, eta = 1;
+    TrowbridgeReitzDistribution distrib;
+
+    PBRT_CPU_GPU bool Active() const { return weight > 0 && eta != 1; }
+    PBRT_CPU_GPU bool Smooth() const { return distrib.EffectivelySmooth(); }
+    // Untinted, unweighted directional albedo for wo (upper hemisphere).
+    PBRT_CPU_GPU Float Albedo(Vector3f wo) const {
+        if (Smooth())
+            return FrDielectric(wo.z, eta);
+        return HdPbrtDielectricAlbedo(wo.z, distrib.MeanAlpha(), eta);
+    }
+    // 1 - w E(wo): what reaches the layers below.
+    PBRT_CPU_GPU Float Throughput(Vector3f wo) const {
+        return Active() ? Clamp(1 - weight * Albedo(wo), 0, 1) : Float(1);
+    }
+    // Weighted BRDF for rough lobes (0 for smooth ones), wo/wi upper.
+    PBRT_CPU_GPU Float F(Vector3f wo, Vector3f wi, Vector3f wm) const {
+        if (!Active() || Smooth())
+            return 0;
+        Float F = FrDielectric(AbsDot(wo, wm), eta);
+        return weight * distrib.D(wm) * distrib.G(wo, wi) * F /
+               (4 * AbsCosTheta(wi) * AbsCosTheta(wo));
+    }
+    PBRT_CPU_GPU Float PDF(Vector3f wo, Vector3f wm) const {
+        return distrib.PDF(wo, wm) / (4 * AbsDot(wo, wm));
+    }
+};
+
 // HdPbrtLayeredBxDF Definition
 // MaterialX/OpenPBR-style vertical layering, as USD's reference renderer and
 // MaterialX's shaders do it. Layers, top to bottom:
 //   [sheen]        Charlie sheen (OpenPBR fuzz: on top of everything)
+//   [coat]         GGX dielectric reflection; tints everything below
 //   specular       GGX dielectric reflection, weight w, tint
 //   [sheen]        (standard_surface sheen: between specular and base)
 //   base           Lambert R / pi  +  straight transmission T (thin walls)
@@ -1167,19 +1199,20 @@ class HdPbrtLayeredBxDF {
     HdPbrtLayeredBxDF() = default;
     PBRT_CPU_GPU
     HdPbrtLayeredBxDF(SampledSpectrum R, SampledSpectrum T, SampledSpectrum specTint,
-                      Float specWeight, Float eta, TrowbridgeReitzDistribution mfDistrib,
-                      SampledSpectrum sheenColor, Float sheenWeight, Float sheenAlpha,
-                      bool sheenOnTop)
