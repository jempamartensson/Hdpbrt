                 Vector3f wi(-wo.x, -wo.y, wo.z);
-                SampledSpectrum f = specTint * (k.spec * specWeight *
-                                                FrDielectric(wo.z, eta) / AbsCosTheta(wi));
-                bs = BSDFSample(f, wi, p.spec, BxDFFlags::SpecularReflection);
