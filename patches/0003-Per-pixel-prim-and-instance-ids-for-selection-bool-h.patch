 };
 
@@ -233,7 +234,7 @@ class RGBFilm : public FilmBase {
   public:
     // RGBFilm Public Methods
     PBRT_CPU_GPU
-    bool UsesVisibleSurface() const { return writeDepth; }
+    bool UsesVisibleSurface() const { return writeDepth || writeIds; }
 
     PBRT_CPU_GPU
     void AddSample(Point2i pFilm, SampledSpectrum L, const SampledWavelengths &lambda,
@@ -252,22 +253,37 @@ class RGBFilm : public FilmBase {
         for (int c = 0; c < 3; ++c)
             pixel.rgbSum[c] += weight * rgb[c];
         pixel.weightSum += weight;
-        // hdPbrt: nearest camera-space depth of the first hit.
-        if (writeDepth && visibleSurface && *visibleSurface) {
+        // hdPbrt: nearest camera-space depth of the first hit, and the ids of
+        // the primitive and instance hit there.
+        if ((writeDepth || writeIds) && visibleSurface && *visibleSurface) {
             Float z = cameraFromRender(visibleSurface->p).z;
-            if (z < pixel.depth)
+            if (z < pixel.depth) {
                 pixel.depth = z;
+                pixel.primId = visibleSurface->hdpbrtPrimId;
+                pixel.instanceId = visibleSurface->hdpbrtInstanceId;
+            }
         }
     }
 
     // hdPbrt: camera-space z of the nearest first hit (+inf where nothing was hit).
     PBRT_CPU_GPU
     Float GetPixelDepth(Point2i p) const { return pixels[p].depth; }
+    // hdPbrt: "integer hdpbrtprimid" of the shape and "hdpbrtinstanceid" of
+    // the object instance at the nearest first hit (-1 = none).
+    PBRT_CPU_GPU
+    int GetPixelPrimId(Point2i p) const { return pixels[p].primId; }
+    PBRT_CPU_GPU
+    int GetPixelInstanceId(Point2i p) const { return pixels[p].instanceId; }
     bool WritesDepth() const { return writeDepth; }
+    bool WritesIds() const { return writeIds; }
     void EnableDepth(const Transform &camFromRender) {
         writeDepth = true;
         cameraFromRender = camFromRender;
     }
+    void EnableIds(const Transform &camFromRender) {
+        writeIds = true;
+        cameraFromRender = camFromRender;
+    }
 
     PBRT_CPU_GPU
     RGB GetPixelRGB(Point2i p, Float splatScale = 1) const {
@@ -313,6 +329,7 @@ class RGBFilm : public FilmBase {
     PBRT_CPU_GPU void ResetPixel(Point2i p) {
         memset(&pixels[p], 0, sizeof(Pixel));
         pixels[p].depth = Infinity;
+        pixels[p].primId = pixels[p].instanceId = -1;
     }
 
