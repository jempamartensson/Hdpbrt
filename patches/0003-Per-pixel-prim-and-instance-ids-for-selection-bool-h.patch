From 74ef20807015ae6757e51c495c9142ebd86deb03 Mon Sep 17 00:00:00 2001
From: jempa <jempamartensson@gmail.com>
Date: Sun, 22 Nov 2026 17:27:54 +0100
Subject: [PATCH 03/41] Per-pixel prim and instance ids for selection ("bool
 hdpbrtids"), streamed as display channels primId and instanceId (for hdPbrt)

Shapes take "integer hdpbrtprimid"; an ObjectInstance takes its id from
Attribute "shape" "integer hdpbrtinstanceid". RGBFilm keeps the ids of the
nearest first hit per pixel (like the hdpbrtdepth Z channel).

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 src/pbrt/cpu/integrators.cpp | 32 +++++++++++++++++-----
 src/pbrt/cpu/primitive.cpp   |  5 ++++
 src/pbrt/cpu/primitive.h     |  8 ++++++
 src/pbrt/film.cpp            |  9 ++++++-
 src/pbrt/film.h              | 28 ++++++++++++++++----
 src/pbrt/interaction.h       |  2 ++
 src/pbrt/scene.cpp           | 51 ++++++++++++++++++++++++++----------
 src/pbrt/scene.h             |  2 ++
 src/pbrt/util/transform.cpp  |  4 +++
 9 files changed, 114 insertions(+), 27 deletions(-)

diff --git a/src/pbrt/cpu/integrators.cpp b/src/pbrt/cpu/integrators.cpp
index 4e91cfa..b7e736d 100644
--- a/src/pbrt/cpu/integrators.cpp
+++ b/src/pbrt/cpu/integrators.cpp
@@ -144,23 +144,41 @@ void ImageTileIntegrator::Render() {
     // Connect to display server if needed
     if (!Options->displayServer.empty()) {
         Film film = camera.GetFilm();
-        // hdPbrt: also stream the depth channel when the film records it.
+        // hdPbrt: also stream the depth (Z) and id (primId, instanceId)
+        // channels when the film records them. Ids are sent as float values
+        // (exact up to 2^24).
         RGBFilm *rgbFilm = film.CastOrNullptr<RGBFilm>();
-        if (rgbFilm && rgbFilm->WritesDepth())
-            DisplayDynamic(film.GetFilename(), Point2i(pixelBounds.Diagonal()),
-                           {"R", "G", "B", "Z"},
-                           [&, rgbFilm](Bounds2i b, pstd::span<pstd::span<float>> displayValue) {
+        if (rgbFilm && (rgbFilm->WritesDepth() || rgbFilm->WritesIds())) {
+            const bool depth = rgbFilm->WritesDepth(), ids = rgbFilm->WritesIds();
+            std::vector<std::string> channels = {"R", "G", "B"};
+            if (depth)
+                channels.push_back("Z");
+            if (ids) {
+                channels.push_back("primId");
+                channels.push_back("instanceId");
+            }
+            DisplayDynamic(film.GetFilename(), Point2i(pixelBounds.Diagonal()), channels,
+                           [&, rgbFilm, depth, ids](Bounds2i b,
+                                                    pstd::span<pstd::span<float>> displayValue) {
                                int index = 0;
                                for (Point2i p : b) {
                                    Point2i pp = pixelBounds.pMin + p;
                                    RGB rgb = film.GetPixelRGB(pp, 2.f / (waveStart + waveEnd));
                                    for (int c = 0; c < 3; ++c)
                                        displayValue[c][index] = rgb[c];
-                                   displayValue[3][index] = rgbFilm->GetPixelDepth(pp);
+                                   int c = 3;
+                                   if (depth)
+                                       displayValue[c++][index] = rgbFilm->GetPixelDepth(pp);
+                                   if (ids) {
+                                       displayValue[c++][index] =
+                                           Float(rgbFilm->GetPixelPrimId(pp));
+                                       displayValue[c++][index] =
+                                           Float(rgbFilm->GetPixelInstanceId(pp));
+                                   }
                                    ++index;
                                }
                            });
-        else
+        } else
         DisplayDynamic(film.GetFilename(), Point2i(pixelBounds.Diagonal()),
                        {"R", "G", "B"},
                        [&](Bounds2i b, pstd::span<pstd::span<float>> displayValue) {
diff --git a/src/pbrt/cpu/primitive.cpp b/src/pbrt/cpu/primitive.cpp
