 }
 
+// hdPbrt: the brightness normalization of a light's spectrum. pbrt divides
+// by the luminance (1 nit per unit of scale); with "bool hdpbrtpowernormalize"
+// a spectrum given in nanometers (also outside the visible range, where it has
+// no luminance) instead carries the radiant power of the color space's white
+// at 1 nit, so an 850 nm light of intensity 1 emits as much power as a white
+// light of intensity 1.
+static Float HdPbrtSpectrumNormalization(const ParameterDictionary &parameters,
+                                         Spectrum s, const RGBColorSpace *colorSpace) {
+    if (!parameters.GetOneBool("hdpbrtpowernormalize", false))
+        return 1 / SpectrumToPhotometric(s);
+    const Spectrum white = &colorSpace->illuminant;
+    Float sPower = 0, whitePower = 0;
+    for (Float l = Lambda_min; l <= Lambda_max; ++l)
+        sPower += s(l);
+    for (Float l = 360; l <= 830; ++l)  // white's power over the visible range
+        whitePower += white(l);
+    if (sPower <= 0)
+        return 0;
+    return whitePower / SpectrumToPhotometric(white) / sPower;
+}
+
