From: jempa <jempamartensson@gmail.com>
Date: Thu, 26 Nov 2026 08:21:14 +0100
Subject: [PATCH 37/40] Spectral lights and camera: 360-1100 nm,
 power-normalized light spectra, Gaussian band sensor (for hdPbrt)

- Lambda_max 830 -> 1100 nm. Visible rendering is unchanged (camera
  wavelengths still from SampleVisible; CIE curves are 0 beyond 830).
- Lights: "bool hdpbrtpowernormalize" normalizes a spectrum by radiant
  power (that of the color space's white at 1 nit over 360-830) instead of
  luminance, so infrared/ultraviolet light spectra work.
- RGBFilm sensor "hdpbrtbands" with "float hdpbrtsensorbands" [center FWHM]
  x 3: Gaussian channel responses written raw, wavelengths sampled
  uniformly over the bands.
---
 src/pbrt/film.cpp        | 37 +++++++++++++++++++++++++++++++++++++
 src/pbrt/film.h          | 24 ++++++++++++++++++++++++
 src/pbrt/lights.cpp      | 34 ++++++++++++++++++++++++++++------
 src/pbrt/util/spectrum.h |  6 +++++-
 4 files changed, 94 insertions(+), 7 deletions(-)

diff --git a/src/pbrt/film.cpp b/src/pbrt/film.cpp
index 42ccedb..c5c5d42 100644
--- a/src/pbrt/film.cpp
+++ b/src/pbrt/film.cpp
@@ -241,6 +241,43 @@ PixelSensor *PixelSensor::Create(const ParameterDictionary &parameters,
     if (sensorName == "cie1931") {
         return alloc.new_object<PixelSensor>(colorSpace, sensorIllum, imagingRatio,
                                              alloc);
+    } else if (sensorName == "hdpbrtbands") {
+        // hdPbrt: three Gaussian channel responses, "float hdpbrtsensorbands"
+        // [center FWHM] x 3 in nm (e.g. infrared false color). Each channel is
+        // normalized so that an equal-energy spectrum carrying the radiant power
+        // of the color space's white at 1 nit (what a white light of intensity 1
+        // emits) reads 1; the film writes the channels unconverted.
+        std::vector<Float> b = parameters.GetFloatArray("hdpbrtsensorbands");
+        if (b.size() != 6)
+            ErrorExit(loc, "\"hdpbrtsensorbands\" needs 6 values (center, FWHM per channel).");
+        const Spectrum white = &colorSpace->illuminant;
+        Float whitePower = 0;  // over the visible range (illuminant tables differ beyond)
+        for (Float l = 360; l <= 830; ++l)
+            whitePower += white(l);
+        whitePower /= SpectrumToPhotometric(white);
+        const Float flat = whitePower / (830 - 360);  // per nm, as white over 360-830
+        Float lo = Lambda_max, hi = Lambda_min;
+        Spectrum ch[3];
+        for (int c = 0; c < 3; ++c) {
+            const Float center = b[2 * c], sigma = std::max<Float>(b[2 * c + 1], 1) / 2.35482f;
+            lo = std::min(lo, center - 3 * sigma);
+            hi = std::max(hi, center + 3 * sigma);
+            std::vector<Float> samples;
+            Float sum = 0;
+            for (Float l = Lambda_min; l <= Lambda_max; ++l) {
+                const Float v = std::exp(-Sqr(l - center) / (2 * Sqr(sigma)));
+                samples.push_back(l);
+                samples.push_back(v);
+                sum += v;
+            }
+            for (size_t i = 1; i < samples.size(); i += 2)
+                samples[i] /= flat * sum;
+            ch[c] = PiecewiseLinearSpectrum::FromInterleaved(samples, false, alloc);
+        }
+        lo = Clamp(lo, Lambda_min, Lambda_max);
+        hi = Clamp(hi, Lambda_min, Lambda_max);
+        return alloc.new_object<PixelSensor>(ch[0], ch[1], ch[2], colorSpace, imagingRatio,
+                                             lo, hi, alloc);
     } else {
         Spectrum r = GetNamedSpectrum(sensorName + "_r");
         Spectrum g = GetNamedSpectrum(sensorName + "_g");
