#usda 1.0
# Curved motion blur test. Frame 1, camera shutter 0..1:
#  - /World/arm rotates 180 degrees about Y; the sphere on it should smear
#    along a half circle (pbrt:xformSamples > 2), not the chord (2 samples).
#  - /World/wave's top edge rises until frame 1.5 and falls back by frame 2
#    (pbrt:geoSamples >= 3 shows the up-and-down; 2 samples show nothing moving).
# Render: hython render_settings.py out.png curved_scene.usda 1 pbrt:xformSamples=9 pbrt:geoSamples=9
(
    defaultPrim = "World"
    endTimeCode = 2
    startTimeCode = 1
    upAxis = "Y"
)

def Xform "World"
{
    def Mesh "ground"
    {
        int[] faceVertexCounts = [4]
        int[] faceVertexIndices = [0, 1, 2, 3]
        point3f[] points = [(-5, -0.5, 5), (5, -0.5, 5), (5, -0.5, -5), (-5, -0.5, -5)]
        uniform token subdivisionScheme = "none"
        color3f[] primvars:displayColor = [(0.5, 0.5, 0.5)]
    }

    def Xform "arm"
    {
        float xformOp:rotateY.timeSamples = {
            1: 0,
            2: 180,
        }
        uniform token[] xformOpOrder = ["xformOp:rotateY"]

        def Sphere "ball"
        {
            double radius = 0.25
            color3f[] primvars:displayColor = [(0.9, 0.15, 0.1)]
            double3 xformOp:translate = (1.5, 0, 0)
            uniform token[] xformOpOrder = ["xformOp:translate"]
        }
    }

    def Mesh "wave"
    {
        int[] faceVertexCounts = [4]
        int[] faceVertexIndices = [0, 1, 2, 3]
        point3f[] points.timeSamples = {
            1: [(2.2, -0.5, 1), (3.2, -0.5, 1), (3.2, 0, 1), (2.2, 0, 1)],
            1.5: [(2.2, -0.5, 1), (3.2, -0.5, 1), (3.2, 1.5, 1), (2.2, 1.5, 1)],
            2: [(2.2, -0.5, 1), (3.2, -0.5, 1), (3.2, 0, 1), (2.2, 0, 1)],
        }
        uniform token subdivisionScheme = "none"
        color3f[] primvars:displayColor = [(0.1, 0.7, 0.2)]
    }

    def DistantLight "sun"
    {
        float inputs:intensity = 3
        float xformOp:rotateX = -60
        uniform token[] xformOpOrder = ["xformOp:rotateX"]
    }

    def DomeLight "sky"
    {
        float inputs:intensity = 0.4
    }

    def Camera "cam"
    {
        float focalLength = 24
        double shutter:open = 0
        double shutter:close = 1
        float xformOp:rotateX = -50
        double3 xformOp:translate = (0.5, 6.5, 5.5)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:rotateX"]
    }
}
