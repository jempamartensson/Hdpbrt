#usda 1.0
(
    defaultPrim = "standard_shader_ball_scene"
    metersPerUnit = 0.01
    renderSettingsPrimPath = "/Render/RenderSettings"
    subLayers = [
        @../_assets/shaderball/scene.usda@
    ]
    upAxis = "Y"
)

def Scope "Looks"
{
    def Material "op_disp_abbe10" (
    )
    {
        token outputs:mtlx:surface.connect = </Looks/op_disp_abbe10/surface_shader1.outputs:out>
        token outputs:surface.connect = </Looks/op_disp_abbe10/surface_shader1.outputs:out>

        def Shader "surface_shader1"
        {
            uniform token info:id = "ND_open_pbr_surface_surfaceshader"
            float inputs:transmission_weight = 1
            float inputs:specular_roughness = 0
            float inputs:transmission_dispersion_scale = 1
            float inputs:transmission_dispersion_abbe_number = 10
            token outputs:out
        }
    }
}

over "standard_shader_ball_scene"
{
    over "shader_ball"
    {
        over "material_surface" (
            prepend apiSchemas = ["MaterialBindingAPI"]
        )
        {
            rel material:binding = </Looks/op_disp_abbe10>
        }

    }
}

over "Render"
{
    over "Product"
    {
        token productName = "dispersion/op_disp_abbe10.exr"
    }
}
