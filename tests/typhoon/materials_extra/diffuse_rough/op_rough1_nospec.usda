#usda 1.0
(
    defaultPrim = "standard_shader_ball_scene"
    metersPerUnit = 0.01
    renderSettingsPrimPath = "/Render/RenderSettings"
    subLayers = [
        @../_assets/shaderball/scene.usda@
    ]
    upAxis = "Y"
)

def Scope "Looks"
{
    def Material "op_rough1_nospec" (
    )
    {
        token outputs:mtlx:surface.connect = </Looks/op_rough1_nospec/surface_shader1.outputs:out>
        token outputs:surface.connect = </Looks/op_rough1_nospec/surface_shader1.outputs:out>

        def Shader "surface_shader1"
        {
            uniform token info:id = "ND_open_pbr_surface_surfaceshader"
            color3f inputs:base_color = (0.8, 0.45, 0.25)
            float inputs:base_diffuse_roughness = 1
            float inputs:specular_weight = 0
            token outputs:out
        }
    }
}

over "standard_shader_ball_scene"
{
    over "shader_ball"
    {
        over "material_surface" (
            prepend apiSchemas = ["MaterialBindingAPI"]
        )
        {
            rel material:binding = </Looks/op_rough1_nospec>
        }

    }
}

over "Render"
{
    over "Product"
    {
        token productName = "diffuse_rough/op_rough1_nospec.exr"
    }
}
