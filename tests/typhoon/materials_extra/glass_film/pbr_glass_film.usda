#usda 1.0
(
    defaultPrim = "standard_shader_ball_scene"
    metersPerUnit = 0.01
    renderSettingsPrimPath = "/Render/RenderSettings"
    subLayers = [
        @../_assets/shaderball/scene.usda@
    ]
    upAxis = "Y"
)

def Scope "Looks"
{
    def Material "pbr_glass_film" (
    )
    {
        token outputs:mtlx:surface.connect = </Looks/pbr_glass_film/surface.outputs:out>
        token outputs:surface.connect = </Looks/pbr_glass_film/surface.outputs:out>

        def Shader "node_under_test"
        {
            uniform token info:id = "ND_dielectric_bsdf"
            string inputs:scatter_mode = "RT"
            float2 inputs:roughness = (0, 0)
            float inputs:thinfilm_thickness = 400
            float inputs:thinfilm_ior = 1.8
            token outputs:out
        }

        def Shader "surface"
        {
            uniform token info:id = "ND_surface"
            token inputs:bsdf.connect = </Looks/pbr_glass_film/node_under_test.outputs:out>
            token outputs:out
        }
    }
}

over "standard_shader_ball_scene"
{
    over "shader_ball"
    {
        over "material_surface" (
            prepend apiSchemas = ["MaterialBindingAPI"]
        )
        {
            rel material:binding = </Looks/pbr_glass_film>
        }

    }
}

over "Render"
{
    over "RenderSettings"
    {
        uniform int ty:convergedSamplesPerPixel = 128

    }

    over "Product"
    {
        token productName = "glass_film/pbr_glass_film.exr"
    }
}
