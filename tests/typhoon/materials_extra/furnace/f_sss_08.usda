#usda 1.0
(
    defaultPrim = "World"
    metersPerUnit = 1
    renderSettingsPrimPath = "/Render/RenderSettings"
    upAxis = "Y"
)

def Xform "World"
{
    def Camera "camera"
    {
        float focalLength = 50
        float horizontalAperture = 24
        float verticalAperture = 24
        double3 xformOp:translate = (0, 0, 6)
        uniform token[] xformOpOrder = ["xformOp:translate"]
    }

    def DomeLight "dome"
    {
        color3f inputs:color = (1, 1, 1)
        float inputs:intensity = 1
    }

    def Sphere "ball" (
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
    {
        double radius = 1
        rel material:binding = </World/Looks/f_sss_08>
    }

    def Scope "Looks"
    {
        def Material "f_sss_08"
        {
            token outputs:mtlx:surface.connect = </World/Looks/f_sss_08/node_under_test.outputs:out>
            token outputs:surface.connect = </World/Looks/f_sss_08/node_under_test.outputs:out>

            def Shader "node_under_test"
            {
                uniform token info:id = "ND_open_pbr_surface_surfaceshader"
                float inputs:subsurface_weight = 1
                color3f inputs:subsurface_color = (0.8, 0.8, 0.8)
                float inputs:subsurface_radius = 0.3
                color3f inputs:subsurface_radius_scale = (1, 1, 1)
                float inputs:specular_weight = 0
                token outputs:out
            }
        }
    }
}

def Scope "Render"
{
    def RenderSettings "RenderSettings" (
        prepend apiSchemas = ["TyphoonRenderSettingsAPI"]
    )
    {
        rel camera = </World/camera>
        rel products = [</Render/Product>]
        uniform int2 resolution = (64, 64)
        uniform int ty:convergedSamplesPerPixel = 16
    }

    def RenderProduct "Product"
    {
        rel camera = </World/camera>
        rel orderedVars = [</Render/Product/Var>]
        token productType = "raster"
        token productName = "furnace/f_sss_08.exr"

        def RenderVar "Var"
        {
            token dataType = "color4f"
            string sourceName = "color"
            token sourceType = "raw"
        }
    }
}
