#usda 1.0
(
    defaultPrim = "standard_shader_ball_scene"
    metersPerUnit = 0.01
    renderSettingsPrimPath = "/Render/RenderSettings"
    subLayers = [
        @../_assets/shaderball/scene.usda@
    ]
    upAxis = "Y"
)

def Scope "Looks"
{
    def Material "tex_coat_metal" (
    )
    {
        token outputs:mtlx:surface.connect = </Looks/tex_coat_metal/surface_shader1.outputs:out>
        token outputs:surface.connect = </Looks/tex_coat_metal/surface_shader1.outputs:out>

        def Shader "surface_shader1"
        {
            uniform token info:id = "ND_open_pbr_surface_surfaceshader"
            color3f inputs:base_color.connect = </Looks/tex_coat_metal/NG/base_tex.outputs:out>
            float inputs:coat_weight = 1
            float inputs:base_metalness = 1
            token outputs:out
        }

        def NodeGraph "NG"
        {
            def Shader "uv_scale"
            {
                uniform token info:id = "ND_convert_float_vector2"
                float inputs:in = 8
                float2 outputs:out
            }

            def Shader "base_tex"
            {
                uniform token info:id = "ND_tiledimage_color3"
                asset inputs:file = @../_assets/materials/Materials/surfaces/standard_surface/textured/textures/checker.png@
                float2 inputs:uvtiling.connect = </Looks/tex_coat_metal/NG/uv_scale.outputs:out>
                color3f outputs:out
            }
        }
    }
}

over "standard_shader_ball_scene"
{
    over "shader_ball"
    {
        over "material_surface" (
            prepend apiSchemas = ["MaterialBindingAPI"]
        )
        {
            rel material:binding = </Looks/tex_coat_metal>
        }

    }
}

over "Render"
{
    over "Product"
    {
        token productName = "coat_dark/tex_coat_metal.exr"
    }
}
