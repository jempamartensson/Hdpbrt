#usda 1.0
(
    defaultPrim = "standard_shader_ball_scene"
    metersPerUnit = 0.01
    renderSettingsPrimPath = "/Render/RenderSettings"
    subLayers = [
        @../_assets/shaderball/scene.usda@
    ]
    upAxis = "Y"
)

def Scope "Looks"
{
    def Material "op_metal_film_w05" (
    )
    {
        token outputs:mtlx:surface.connect = </Looks/op_metal_film_w05/surface_shader1.outputs:out>
        token outputs:surface.connect = </Looks/op_metal_film_w05/surface_shader1.outputs:out>

        def Shader "surface_shader1"
        {
            uniform token info:id = "ND_open_pbr_surface_surfaceshader"
            float inputs:base_metalness = 1
            color3f inputs:base_color = (0.6, 0.6, 0.65)
            color3f inputs:specular_color = (0.8, 0.9, 1.0)
            float inputs:specular_roughness = 0.25
            float inputs:thin_film_weight = 0.5
            float inputs:thin_film_thickness = 0.25
            float inputs:thin_film_ior = 1.4
            token outputs:out
        }
    }
}

over "standard_shader_ball_scene"
{
    over "shader_ball"
    {
        over "material_surface" (
            prepend apiSchemas = ["MaterialBindingAPI"]
        )
        {
            rel material:binding = </Looks/op_metal_film_w05>
        }

    }
}

over "Render"
{
    over "Product"
    {
        token productName = "metal_film/op_metal_film_w05.exr"
    }
}
