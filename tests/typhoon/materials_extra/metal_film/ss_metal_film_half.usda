#usda 1.0
(
    defaultPrim = "standard_shader_ball_scene"
    metersPerUnit = 0.01
    renderSettingsPrimPath = "/Render/RenderSettings"
    subLayers = [
        @../_assets/shaderball/scene.usda@
    ]
    upAxis = "Y"
)

def Scope "Looks"
{
    def Material "ss_metal_film_half" (
    )
    {
        token outputs:mtlx:surface.connect = </Looks/ss_metal_film_half/surface_shader1.outputs:out>
        token outputs:surface.connect = </Looks/ss_metal_film_half/surface_shader1.outputs:out>

        def Shader "surface_shader1"
        {
            uniform token info:id = "ND_standard_surface_surfaceshader"
            float inputs:metalness = 0.5
            color3f inputs:base_color = (0.3, 0.5, 0.8)
            float inputs:specular_roughness = 0.2
            float inputs:thin_film_thickness = 550
            float inputs:thin_film_IOR = 1.33
            token outputs:out
        }
    }
}

over "standard_shader_ball_scene"
{
    over "shader_ball"
    {
        over "material_surface" (
            prepend apiSchemas = ["MaterialBindingAPI"]
        )
        {
            rel material:binding = </Looks/ss_metal_film_half>
        }

    }
}

over "Render"
{
    over "Product"
    {
        token productName = "metal_film/ss_metal_film_half.exr"
    }
}
