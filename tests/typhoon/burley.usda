#usda 1.0
(
    doc = """Burley diffuse (pbrlib burley_diffuse_bsdf, color 0.8) on a radius-1 sphere,
    no floor, direct lighting only. Frames 1-3: uniform dome radiance 1 at roughness
    0 / 0.55 / 1; frames 4-5: a 1-degree sun (normalize, intensity 3) at roughness 0 / 1.
    Compare per pixel (Typhoon's sphere is ~11% small), not whole frames."""
    defaultPrim = "World"
    endTimeCode = 5
    metersPerUnit = 1
    renderSettingsPrimPath = "/Render/Settings"
    startTimeCode = 1
    upAxis = "Y"
)

def Xform "World"
{
    def Camera "camera"
    {
        float2 clippingRange = (0.1, 1000)
        float focalLength = 50
        float horizontalAperture = 36
        float verticalAperture = 36
        token projection = "perspective"
        double3 xformOp:translate = (0, 1, 6)
        uniform token[] xformOpOrder = ["xformOp:translate"]
    }

    def DomeLight "dome"
    {
        float inputs:intensity.timeSamples = {1: 1, 2: 1, 3: 1, 4: 0, 5: 0}
    }

    def DistantLight "sun"
    {
        float inputs:angle = 1
        bool inputs:normalize = 1
        float inputs:intensity.timeSamples = {1: 0, 2: 0, 3: 0, 4: 3, 5: 3}
        float3 xformOp:rotateXYZ = (-30, 40, 0)
        uniform token[] xformOpOrder = ["xformOp:rotateXYZ"]
    }

    def Mesh "floor" (
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
    {
        float3[] extent = [(-500, 0, -500), (500, 0, 500)]
        int[] faceVertexCounts = [4]
        int[] faceVertexIndices = [0, 1, 2, 3]
        point3f[] points = [(-500, 0, 500), (500, 0, 500), (500, 0, -500), (-500, 0, -500)]
        rel material:binding = </World/Looks/white>
        token visibility = "invisible"
    }

    def Sphere "ball" (
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
    {
        double radius = 1
        rel material:binding = </World/Looks/white>
        double3 xformOp:translate = (0, 1, 0)
        uniform token[] xformOpOrder = ["xformOp:translate"]
    }

    def Scope "Looks"
    {
        def Material "white"
        {
            token outputs:mtlx:surface.connect = </World/Looks/white/surface.outputs:out>
            token outputs:surface.connect = </World/Looks/white/surface.outputs:out>

            def Shader "bsdf"
            {
                uniform token info:id = "ND_burley_diffuse_bsdf"
                color3f inputs:color = (0.8, 0.8, 0.8)
                float inputs:roughness.timeSamples = {1: 0, 2: 0.55, 3: 1, 4: 0, 5: 1}
                token outputs:out
            }

            def Shader "surface"
            {
                uniform token info:id = "ND_surface"
                token inputs:bsdf.connect = </World/Looks/white/bsdf.outputs:out>
                token outputs:out
            }
        }
    }
}

def Scope "Render"
{
    def RenderSettings "Settings" (
        prepend apiSchemas = ["TyphoonRenderSettingsAPI"]
    )
    {
        rel camera = </World/camera>
        rel products = [</Render/Product>]
        uniform bool disableMotionBlur = 1
        bool instantaneousShutter = 1
        uniform int2 resolution = (200, 200)
        int ty:convergedSamplesPerPixel = 1024
        int ty:maxBounces = 0
        float ty:fireflyClampThreshold = 0.0
        float ty:causticsClampThreshold = 0.0
    }

    def RenderProduct "Product"
    {
        rel camera = </World/camera>
        rel orderedVars = [</Render/Product/Color>]
        token productType = "raster"
        token productName = "burley.exr"

        def RenderVar "Color"
        {
            token dataType = "color4f"
            string sourceName = "color"
            token sourceType = "raw"
        }
    }
}
