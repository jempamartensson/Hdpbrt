#usda 1.0
(
    doc = """Light and shadow linking vs Typhoon (tests/typhoon/run_linking.sh).
    A: rect light, lightLink = sphereA + the native instance only.
    B: sun, lightLink = all but sphereB (sphereB still casts its shadow).
    C: sphere light, shadowLink = all but the wall (the wall is lit, casts no C shadow).
    D: dome, lightLink = all but the floor.
    Frame 1: all lights; frames 2-5: A, B, C, D alone. Direct lighting only."""
    defaultPrim = "World"
    endTimeCode = 5
    framesPerSecond = 24
    metersPerUnit = 1
    renderSettingsPrimPath = "/Render/Settings"
    startTimeCode = 1
    timeCodesPerSecond = 24
    upAxis = "Y"
)

class Xform "_proto"
{
    def Sphere "ball" (
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
    {
        double radius = 0.5
        rel material:binding = </World/Looks/white>
    }
}

def Xform "World"
{
    def Camera "camera"
    {
        float2 clippingRange = (0.1, 1000)
        float focalLength = 35
        float horizontalAperture = 36
        float verticalAperture = 36
        token projection = "perspective"
        matrix4d xformOp:transform = ( (1, 0, 0, 0), (0, 0.903278, -0.429057, 0), (0, 0.429057, 0.903278, 0), (0, 4.5, 8, 1) )
        uniform token[] xformOpOrder = ["xformOp:transform"]
    }

    def RectLight "lightA" (
        prepend apiSchemas = ["CollectionAPI:lightLink"]
    )
    {
        color3f inputs:color = (1, 0.6, 0.3)
        float inputs:height = 1
        float inputs:width = 1
        float inputs:intensity.timeSamples = {1: 8, 2: 8, 3: 0, 4: 0, 5: 0}
        uniform bool collection:lightLink:includeRoot = 0
        rel collection:lightLink:includes = [</World/sphereA>, </World/inst>]
        double3 xformOp:translate = (-1.5, 2.5, 1.5)
        float3 xformOp:rotateXYZ = (-60, 0, 0)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:rotateXYZ"]
    }

    def DistantLight "lightB" (
        prepend apiSchemas = ["CollectionAPI:lightLink"]
    )
    {
        float inputs:angle = 5
        color3f inputs:color = (0.7, 0.85, 1)
        bool inputs:normalize = 1
        float inputs:intensity.timeSamples = {1: 2, 2: 0, 3: 2, 4: 0, 5: 0}
        uniform bool collection:lightLink:includeRoot = 1
        rel collection:lightLink:excludes = </World/sphereB>
        float3 xformOp:rotateXYZ = (-50, 30, 0)
        uniform token[] xformOpOrder = ["xformOp:rotateXYZ"]
    }

    def SphereLight "lightC" (
        prepend apiSchemas = ["CollectionAPI:shadowLink"]
    )
    {
        color3f inputs:color = (0.5, 1, 0.5)
        float inputs:radius = 0.2
        float inputs:intensity.timeSamples = {1: 15, 2: 0, 3: 0, 4: 15, 5: 0}
        uniform bool collection:shadowLink:includeRoot = 1
        rel collection:shadowLink:excludes = </World/wall>
        double3 xformOp:translate = (3.2, 1.2, 0)
        uniform token[] xformOpOrder = ["xformOp:translate"]
    }

    def DomeLight "lightD" (
        prepend apiSchemas = ["CollectionAPI:lightLink"]
    )
    {
        color3f inputs:color = (0.6, 0.6, 0.8)
        float inputs:intensity.timeSamples = {1: 0.5, 2: 0, 3: 0, 4: 0, 5: 0.5}
        uniform bool collection:lightLink:includeRoot = 1
        rel collection:lightLink:excludes = </World/floor>
    }

    def Mesh "floor" (
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
    {
        float3[] extent = [(-10, 0, -10), (10, 0, 10)]
        int[] faceVertexCounts = [4]
        int[] faceVertexIndices = [0, 1, 2, 3]
        point3f[] points = [(-10, 0, 10), (10, 0, 10), (10, 0, -10), (-10, 0, -10)]
        rel material:binding = </World/Looks/white>
    }

    def Sphere "sphereA" (
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
    {
        double radius = 0.5
        rel material:binding = </World/Looks/white>
        double3 xformOp:translate = (-1.5, 0.5, 0.5)
        uniform token[] xformOpOrder = ["xformOp:translate"]
    }

    def Sphere "sphereB" (
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
    {
        double radius = 0.5
        rel material:binding = </World/Looks/white>
        double3 xformOp:translate = (0, 0.5, 0.5)
        uniform token[] xformOpOrder = ["xformOp:translate"]
    }

    def Sphere "sphereC" (
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
    {
        double radius = 0.5
        rel material:binding = </World/Looks/white>
        double3 xformOp:translate = (1.3, 0.5, 1.4)
        uniform token[] xformOpOrder = ["xformOp:translate"]
    }

    def Mesh "wall" (
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
    {
        float3[] extent = [(-0.05, 0, -0.8), (0.05, 1.6, 0.8)]
        int[] faceVertexCounts = [4, 4, 4, 4, 4, 4]
        int[] faceVertexIndices = [0, 1, 2, 3, 4, 7, 6, 5, 0, 4, 5, 1, 1, 5, 6, 2, 2, 6, 7, 3, 3, 7, 4, 0]
        point3f[] points = [(-0.05, 0, -0.8), (0.05, 0, -0.8), (0.05, 0, 0.8), (-0.05, 0, 0.8), (-0.05, 1.6, -0.8), (0.05, 1.6, -0.8), (0.05, 1.6, 0.8), (-0.05, 1.6, 0.8)]
        uniform token subdivisionScheme = "none"
        rel material:binding = </World/Looks/white>
        double3 xformOp:translate = (2.3, 0, -0.6)
        uniform token[] xformOpOrder = ["xformOp:translate"]
    }

    def Xform "inst" (
        instanceable = true
        prepend inherits = </_proto>
    )
    {
        double3 xformOp:translate = (-1.0, 0.5, -1.6)
        uniform token[] xformOpOrder = ["xformOp:translate"]
    }

    def Scope "Looks"
    {
        def Material "white"
        {
            token outputs:surface.connect = </World/Looks/white/s.outputs:surface>

            def Shader "s"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.8, 0.8, 0.8)
                float inputs:ior = 1
                int inputs:useSpecularWorkflow = 1
                color3f inputs:specularColor = (0, 0, 0)
                token outputs:surface
            }
        }
    }
}

def Scope "Render"
{
    def RenderSettings "Settings" (
        prepend apiSchemas = ["TyphoonRenderSettingsAPI"]
    )
    {
        rel camera = </World/camera>
        rel products = [</Render/Product>]
        uniform bool disableMotionBlur = 1
        bool instantaneousShutter = 1
        uniform int2 resolution = (200, 200)
        int ty:convergedSamplesPerPixel = 256
        int ty:maxBounces = 0
        float ty:fireflyClampThreshold = 0.0
        float ty:causticsClampThreshold = 0.0
    }

    def RenderProduct "Product"
    {
        rel camera = </World/camera>
        rel orderedVars = [</Render/Product/Color>]
        token productType = "raster"
        token productName = "linking.exr"

        def RenderVar "Color"
        {
            token dataType = "color4f"
            string sourceName = "color"
            token sourceType = "raw"
        }
    }
}
