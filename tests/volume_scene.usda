#usda 1.0
# Volume: Houdini's sample cloud (OpenVDB, density grid) over a ground plane.
# Needs Houdini 22 installed at /opt/hfs22.0.508 for the VDB file.
#   hython hydra_render.py HdPbrtRendererPlugin out.png volume_scene.usda
(
    defaultPrim = "World"
    upAxis = "Y"
)

def Xform "World"
{
    def Mesh "ground"
    {
        int[] faceVertexCounts = [4]
        int[] faceVertexIndices = [0, 1, 2, 3]
        point3f[] points = [(-3, -0.1, 3), (3, -0.1, 3), (3, -0.1, -3), (-3, -0.1, -3)]
        uniform token subdivisionScheme = "none"
        color3f[] primvars:displayColor = [(0.4, 0.4, 0.4)]
    }

    def Volume "cloud"
    {
        rel field:density = </World/cloud/density>
        double3 xformOp:translate = (0, 0.1, 0)
        uniform token[] xformOpOrder = ["xformOp:translate"]

        def OpenVDBAsset "density"
        {
            asset filePath = @/opt/hfs22.0.508/houdini/usd/scenes/noise_sampler/cloud.vdb@
            token fieldName = "density"
        }
    }

    def DistantLight "sun"
    {
        float inputs:intensity = 4
        float xformOp:rotateX = -40
        float xformOp:rotateY = 40
        uniform token[] xformOpOrder = ["xformOp:rotateY", "xformOp:rotateX"]
    }

    def DomeLight "sky"
    {
        color3f inputs:color = (0.5, 0.6, 0.9)
        float inputs:intensity = 0.6
    }

    def Camera "cam"
    {
        float focalLength = 35
        float xformOp:rotateX = -12
        double3 xformOp:translate = (0.15, 0.7, 2.6)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:rotateX"]
    }
}
