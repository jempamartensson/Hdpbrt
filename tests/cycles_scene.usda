#usda 1.0
(
    upAxis = "Y"
)

def "World"
{
    def Sphere "sphere" (
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
    {
        rel material:binding = </World/mat>
        double3 xformOp:translate = (0, 1, 0)
        uniform token[] xformOpOrder = ["xformOp:translate"]
    }

    def Mesh "ground"
    {
        int[] faceVertexCounts = [4]
        int[] faceVertexIndices = [0, 3, 2, 1]
        point3f[] points = [(-5, 0, -5), (5, 0, -5), (5, 0, 5), (-5, 0, 5)]
    }

    def Material "mat"
    {
        token outputs:surface.connect = </World/mat/pbs.outputs:surface>

        def Shader "pbs"
        {
            uniform token info:id = "UsdPreviewSurface"
            color3f inputs:diffuseColor = (0.8, 0.2, 0.1)
            float inputs:roughness = 0.3
            token outputs:surface
        }
    }

    def DistantLight "sun"
    {
        float inputs:intensity = 3
        float3 xformOp:rotateXYZ = (-45, 30, 0)
        uniform token[] xformOpOrder = ["xformOp:rotateXYZ"]
    }

    def DomeLight "dome"
    {
        float inputs:intensity = 0.5
    }

    def Camera "cam"
    {
        float xformOp:rotateX = -10
        double3 xformOp:translate = (0, 2, 7)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:rotateX"]
    }
}

