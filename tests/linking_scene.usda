#usda 1.0
# Light linking: a warm rect light linked only to the red sphere (the ground and
# the blue sphere get none of it), and a sun whose shadow link excludes the blue
# sphere (the blue sphere casts no sun shadow; the red one does).
# hython hydra_render.py HdPbrtRendererPlugin out.png linking_scene.usda
(
    defaultPrim = "World"
    upAxis = "Y"
)

def Xform "World"
{
    def Mesh "ground"
    {
        int[] faceVertexCounts = [4]
        int[] faceVertexIndices = [0, 1, 2, 3]
        point3f[] points = [(-5, 0, 5), (5, 0, 5), (5, 0, -5), (-5, 0, -5)]
        uniform token subdivisionScheme = "none"
        color3f[] primvars:displayColor = [(0.6, 0.6, 0.6)]
    }

    def Sphere "red"
    {
        double radius = 0.7
        color3f[] primvars:displayColor = [(0.8, 0.15, 0.1)]
        double3 xformOp:translate = (-1.1, 0.7, 0)
        uniform token[] xformOpOrder = ["xformOp:translate"]
    }

    def Sphere "blue"
    {
        double radius = 0.7
        color3f[] primvars:displayColor = [(0.1, 0.25, 0.8)]
        double3 xformOp:translate = (1.1, 0.7, 0)
        uniform token[] xformOpOrder = ["xformOp:translate"]
    }

    def RectLight "warm" (
        prepend apiSchemas = ["CollectionAPI:lightLink"]
    )
    {
        float inputs:width = 1.5
        float inputs:height = 1.5
        float inputs:intensity = 25
        color3f inputs:color = (1, 0.55, 0.15)
        uniform bool collection:lightLink:includeRoot = 0
        rel collection:lightLink:includes = </World/red>
        double3 xformOp:translate = (0, 3.5, 2.5)
        float xformOp:rotateX = -55
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:rotateX"]
    }

    def DistantLight "sun" (
        prepend apiSchemas = ["CollectionAPI:shadowLink"]
    )
    {
        float inputs:intensity = 2.5
        uniform bool collection:shadowLink:includeRoot = 1
        rel collection:shadowLink:excludes = </World/blue>
        float xformOp:rotateX = -45
        float xformOp:rotateY = 30
        uniform token[] xformOpOrder = ["xformOp:rotateY", "xformOp:rotateX"]
    }

    def DomeLight "sky"
    {
        float inputs:intensity = 0.15
    }

    def Camera "cam"
    {
        float focalLength = 28
        float xformOp:rotateX = -22
        double3 xformOp:translate = (0, 2.4, 6)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:rotateX"]
    }
}
