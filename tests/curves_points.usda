    def Points "dots"
    {
        point3f[] points = [(2.1, 0.1, -1), (2.02655, 0.16, -0.712345), (1.82418, 0.22, -0.495117), (1.54244, 0.28, -0.401503), (1.25031, 0.34, -0.454422), (1.01931, 0.4, -0.640917), (0.906005, 0.46, -0.915328), (0.938126, 0.52, -1.21047), (1.10781, 0.58, -1.45408), (1.37352, 0.64, -1.58652), (1.6702, 0.7, -1.57535), (1.9252, 0.76, -1.42332), (2.0761, 0.82, -1.16765), (2.08595, 0.88, -0.870928), (1.95234, 0.94, -0.605808), (1.70798, 1, -0.4372), (1.4127, 1.06, -0.406385), (1.13879, 1.12, -0.520908), (0.953322, 1.18, -0.752729), (0.901697, 1.24, -1.04509), (0.996557, 1.3, -1.32641), (1.21468, 1.36, -1.52782), (1.50266, 1.42, -1.59999), (1.78998, 1.48, -1.52527), (2.00631, 1.54, -1.32194), (2.09868, 1.6, -1.03979), (2.04447, 1.66, -0.7479), (1.85695, 1.72, -0.517729), (1.58204, 1.78, -0.405636), (1.28705, 1.84, -0.439063)]
        float[] widths = [0.08, 0.084, 0.088, 0.092, 0.096, 0.1, 0.10400000000000001, 0.108, 0.112, 0.116, 0.12, 0.124, 0.128, 0.132, 0.136, 0.14, 0.14400000000000002, 0.14800000000000002, 0.15200000000000002, 0.156, 0.16, 0.164, 0.16799999999999998, 0.172, 0.176, 0.18, 0.184, 0.188, 0.192, 0.196] (interpolation = "vertex")
        color3f[] primvars:displayColor = [(0.9, 0.3, 0.1)]
    }

    def DistantLight "sun"
    {
        float inputs:intensity = 3
        float xformOp:rotateX = -55
        float xformOp:rotateY = 30
        uniform token[] xformOpOrder = ["xformOp:rotateY", "xformOp:rotateX"]
    }

    def DomeLight "sky"
    {
        float inputs:intensity = 0.4
    }

    def Camera "cam"
    {
        float focalLength = 24
        float xformOp:rotateX = -18
        double3 xformOp:translate = (0, 2.2, 6)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:rotateX"]
    }
}
