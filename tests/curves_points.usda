    def BasisCurves "arc"
    {
        uniform token type = "cubic"
        uniform token basis = "catmullRom"
        uniform token wrap = "pinned"
        int[] curveVertexCounts = [7]
        point3f[] points = [(1.2, 0.1, 0.5), (1.03923, 0.6, 0.5), (0.6, 0.966025, 0.5), (7.34788e-17, 1.1, 0.5), (-0.6, 0.966025, 0.5), (-1.03923, 0.6, 0.5), (-1.2, 0.1, 0.5)]
        float[] widths = [0.12] (interpolation = "constant")
        color3f[] primvars:displayColor = [(0.1, 0.4, 0.9)]
    }

    def BasisCurves "square"
