        normal3f[] normals = [(0, 0, 1), (0, 0.7, 0.7), (0, 1, 0), (0, 0.7, 0.7)] (interpolation = "vertex")
        float[] widths = [0.4] (interpolation = "constant")
        color3f[] primvars:displayColor = [(0.8, 0.1, 0.6)]
